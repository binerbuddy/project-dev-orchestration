#!/usr/bin/env bash
# start-orchestrator — open the "Orchestrator (<project>)" herdr workspace running
# `/loop <ORCHESTRATE_SKILL>` (default ${PDO_SKILL_PREFIX}project-orchestrate) in CONTROL_DIR.
#
# Usage: start-orchestrator [--project P] [--model opus] [--drain]
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
die() { echo "start-orchestrator: $*" >&2; exit 1; }
# shellcheck source=lib.sh
source "$HERE/bin/lib.sh"

PROJECT="" MODEL="" ARGS=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --project) PROJECT="$2"; shift 2 ;;
    --model) MODEL="$2"; shift 2 ;;
    --drain) ARGS="drain"; shift ;;
    *) die "unknown option: $1" ;;
  esac
done
pdo_resolve_project "$PROJECT"
# shellcheck source=/dev/null
HERE="$PDO_ENV_DIR" source "$PDO_ENV_FILE"; pdo_finalize
MODEL="${MODEL:-$DEFAULT_MODEL}"
NAME="Orchestrator ($PROJECT)"
# Reuse the workspace after a crash or kill: relaunch only if no Claude is alive in it.
# All orchestrator state is external (herdr, GitHub, $PDO_STATE_DIR), so a fresh session
# picks up where the dead one stopped; its first tick replaces any orphaned watcher.
WS_ID="$(herdr workspace list | jq -r --arg n "$NAME" '[.result.workspaces[] | select(.label == $n) | .workspace_id][0] // empty')"
if [[ -n "$WS_ID" ]]; then
  if herdr agent list | jq -e --arg w "$WS_ID" '.result.agents[] | select(.workspace_id == $w and .agent == "claude")' >/dev/null; then
    die "the orchestrator is already running in workspace \"$NAME\""
  fi
  echo "restarting the orchestrator in existing workspace \"$NAME\""
else
  WS_ID="$(herdr workspace create --cwd "$CONTROL_DIR" --label "$NAME" --no-focus | jq -r '[.. | objects | .workspace_id? // empty][0]')"
fi
PANE_ID="$(herdr pane list --workspace "$WS_ID" | jq -r '.result.panes[0].pane_id')"
set +e; launch_agent "$PANE_ID" "$CONTROL_DIR" "$NAME" "$MODEL" "/loop $ORCHESTRATE_SKILL $ARGS project=$PROJECT"; rc=$?; set -e
[[ $rc -eq 0 ]] || die "orchestrator did not start cleanly (rc=$rc); see workspace $WS_ID"
herdr agent rename "$PANE_ID" "orchestrator-$PROJECT" >/dev/null 2>&1 || true
echo "orchestrator running in workspace \"$NAME\" (id $WS_ID)"
