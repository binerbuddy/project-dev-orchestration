#!/usr/bin/env python3
"""questions — every question an agent is waiting on the human for, across projects (read-only).

Usage: questions [--project P] [--repo R] [--json]

For the human, or whoever relays to them (a CEO, an assistant agent): each agent whose tab shows a
question (herdr status blocked, or the watcher's question_pending), each agent paused on one
(metadata paused.reason "question", not yet answered), and each agent paused at an open UX or
decision gate (bin/gate). Per question: the project, the agent's tab name, live or paused, how
long it has waited, the issue link, the question text with its options (read from the agent's
Claude Code transcript: the last AskUserQuestion with no answer yet; the last screen lines when
there is none), and how to answer:
  - live: in the agent's tab (only its question UI can answer a menu; nothing types into it);
  - paused: `pdo answer <repo> <n> "<text>" --project P` (the orchestrator resumes it first);
  - paused at a gate: `pdo gate clear <repo> <n> --note "<text>" --project P`;
  - a desk gate (`gate enter --desk`: the human must be at the tab): "answer at the desk", in its tab
    (resumed first with `pdo resume-agent` if it was paused before it was marked).
JSON fields per row: project; repo and issue (null for a standing agent); issue_url (always the
GitHub issue); url (what to look at: a gate's link, else the issue) and url_kind (issue, comment,
pr, doc or artifact); state (live, paused, held) and live_state (live rows: "menu on screen" or
"idle at its prompt"); hours waited; questions (every question in full, with options: a gate's own
questions from `gate enter --question`, else the transcript's; a bare "reviewed it? / Not yet" is
dropped); question (the first one, whole, on one line); recommended (one entry per question: the
option labelled "(Recommended)", else null); gate ({kind, name} when the agent waits at a gate, else
absent); desk (true for a desk gate, which never pauses: answer it at the tab); answer_format, with
several questions "Q1=<option #>; Q2=..." (the answer command comes prefilled with the recommended
options, "?" where there is none); route and route_why (below); answer (how to answer, in words) and
command (the raw command).
Standing agents (orchestrator, QC, manager) with a question on screen are listed too. Nothing is
written; a missing herdr only drops the live half.

A repo with an active Design Lead (bin/design-lead): its agents' questions carry route "design-lead"
and are its to answer, not the human's, unless it escalated one or it has waited
DESIGN_LEAD_ESCALATE_HOURS; then route "human" with the reason in route_why (null when no Design Lead
covers the repo, i.e. it was always the human's). Questions a worker handed
to the Design Lead by peer message (`design-lead ask`) are listed as state "held". `command` (JSON) is
always the raw way to answer. --repo R lists only R's.
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time

sys.dont_write_bytecode = True  # keep the engine checkout free of __pycache__
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import pdo_config  # noqa: E402
import pdo_herdr  # noqa: E402


def read_json(path, default=None):
    try:
        return json.load(open(path, encoding="utf-8"))
    except (OSError, ValueError):
        return default


def screen_tail(pane, n=8):
    r = subprocess.run(["herdr", "pane", "read", pane], capture_output=True, text=True, timeout=15) if pane else None
    lines = [ln for ln in (r.stdout if r and r.returncode == 0 else "").splitlines() if ln.strip()]
    return "\n".join(lines[-n:])


def filler(q):
    """A bare "have you reviewed it? good to proceed?" with a "Not yet" option: it asks nothing to decide."""
    return bool(re.search(r"reviewed|good to proceed", q.get("question") or "", re.I)
                and any((o.get("label") or "").lower().startswith("not yet") for o in q.get("options") or []))


def recommended(q):
    """The option labelled "(Recommended)" of one question, or None."""
    return next((o["label"] for o in q.get("options") or [] if "(recommended)" in o["label"].lower()), None)


def url_kind(url):
    """What a row's url points at: issue, comment, pr, doc or artifact (None without a url)."""
    if not url:
        return None
    if "#issuecomment-" in url or "#discussion_r" in url or "#pullrequestreview-" in url:
        return "comment"
    if re.search(r"github\.com/[^/]+/[^/]+/pull/\d+", url):
        return "pr"
    if re.search(r"github\.com/[^/]+/[^/]+/issues/\d+", url):
        return "issue"
    if re.search(r"/(blob|tree)/|\.(md|html?|pdf)(#|$)", url):
        return "doc"
    return "artifact"


def desk(meta):
    """Its open gate needs the human live at the tab (bin/gate --desk)."""
    g = (meta or {}).get("gate") or {}
    return bool(g.get("desk") and g.get("since") and not g.get("cleared_at"))


def collect(only=None, slots=None, now=None, only_repo=None):
    now = now or time.time()
    try:
        slots = pdo_herdr.slots() if slots is None else slots
    except Exception:  # noqa: BLE001 - no herdr: paused questions only
        slots = []
    out, seen = [], set()
    for p in [only] if only else pdo_config.projects():
        cfg, _ = pdo_config.try_load(p)
        if not cfg:
            continue
        repos = set(cfg.get("repo_root") or {}) - pdo_config.managed_elsewhere(cfg)
        state = cfg["state_dir"]
        snap = (read_json(os.path.join(state, f"{p}-watch.json"), {}) or {}).get("agents", {})
        standing = {f"Orchestrator ({p})", f"Human Review ({p})", f"QC Agent ({p})", cfg.get("manager") or ""} - {""}
        org = cfg.get("org")
        for s in slots:
            label, a = s.get("name") or "", s.get("agent") or {}
            m = re.match(r"^(\S+)-(\d+) ", label)
            mine = (m and m.group(1) in repos) or label in standing
            if not mine or label in seen:
                continue
            key = f"{m.group(1)}#{m.group(2)}" if m and m.group(1) in repos else None
            if not (s.get("status") == "blocked" or (key and (snap.get(key) or {}).get("question_pending"))):
                continue
            seen.add(label)
            meta = read_json(os.path.join(state, "agents", f"{m.group(1)}-{m.group(2)}.json"), {}) if key else {}
            sid = (meta or {}).get("session_id") or ((a.get("agent_session") or {}).get("value"))
            q = pdo_config.pending_question(sid)
            since = (q or {}).get("asked_at") or (time.time() - 60 * (snap.get(key) or {}).get("unchanged_min", 0) if key else None)
            out.append({"project": p, "agent": key, "workspace": label, "state": "live",
                        "hours": round((now - since) / 3600, 1) if since else None,
                        "url": f"https://github.com/{org}/{m.group(1)}/issues/{m.group(2)}" if key else None,
                        "questions": (q or {}).get("questions") or [], "screen": "" if q else screen_tail(s.get("pane_id")),
                        "desk": desk(meta), "answer": ("at the desk: " if desk(meta) else "") + f'in its tab "{label}"'})
            g = (meta or {}).get("gate") or {}
            out[-1]["live_state"] = "menu on screen" if s.get("status") == "blocked" else "idle at its prompt"
            if g.get("since") and not g.get("cleared_at"):
                out[-1]["gate"] = {"kind": g.get("kind"), "name": g.get("name")}
                out[-1]["url"] = g.get("link") or out[-1]["url"]
                out[-1]["questions"] = g.get("questions") or out[-1]["questions"]
        d = os.path.join(state, "agents")
        for f in sorted(os.listdir(d)) if os.path.isdir(d) else []:
            meta = read_json(os.path.join(d, f), {}) or {}
            pz = meta.get("paused") or {}
            repo, num = meta.get("repo"), meta.get("number")
            gate = meta.get("gate") or {}
            if (repo in repos and gate.get("since") and not gate.get("cleared_at") and meta.get("hibernated_at")
                    and not meta.get("done_tracking") and meta.get("name") not in seen):
                seen.add(meta.get("name"))
                q = pdo_config.pending_question(meta.get("session_id"))
                out.append({"project": p, "agent": f"{repo}#{num}", "workspace": meta.get("name"), "state": "paused",
                            "hours": round((now - gate["since"]) / 3600, 1),
                            "url": gate.get("link") or f"https://github.com/{org}/{repo}/issues/{num}",
                            "questions": gate.get("questions") or (q or {}).get("questions") or [],
                            "gate": {"kind": gate.get("kind"), "name": gate.get("name")},
                            "screen": "", "desk": desk(meta),
                            "answer": (f'at the desk: pdo resume-agent {repo} {num} --prompt "The human is at the desk." --project {p}, '
                                       f'then answer in its tab "{meta.get("name")}"') if desk(meta) else
                                      f'pdo gate clear {repo} {num} --note "<text>" --project {p}'})
                continue
            if (repo not in repos or pz.get("reason") != "question" or not meta.get("hibernated_at")
                    or pz.get("answer") or pz.get("reply") or meta.get("done_tracking") or meta.get("name") in seen):
                continue
            seen.add(meta.get("name"))
            q = pdo_config.pending_question(meta.get("session_id"))
            since = pz.get("since") or meta["hibernated_at"]
            out.append({"project": p, "agent": f"{repo}#{num}", "workspace": meta.get("name"), "state": "paused",
                        "hours": round((now - since) / 3600, 1),
                        "url": f"https://github.com/{org}/{repo}/issues/{num}",
                        "questions": (q or {}).get("questions") or [],
                        "screen": "" if q else "\n".join((pz.get("detail") or "").strip().splitlines()[-8:]),
                        "answer": f'pdo answer {repo} {num} "<text>" --project {p}'})
        dl = cfg.get("design_lead")
        held = (pdo_config.design_lead_state(cfg).get("held") or {}) if dl else {}
        for key, h in held.items():
            repo, num = key.split("#")
            meta = read_json(os.path.join(state, "agents", f"{repo}-{num}.json"), {}) or {}
            if repo not in repos or meta.get("done_tracking") or meta.get("name") in seen:
                continue
            seen.add(meta.get("name"))
            out.append({"project": p, "agent": key, "workspace": meta.get("name") or key, "state": "held",
                        "hours": round((now - h.get("asked_at", now)) / 3600, 1),
                        "url": f"https://github.com/{org}/{repo}/issues/{num}",
                        "questions": [{"question": h.get("question") or "", "multiSelect": False, "options": []}],
                        "screen": "", "answer": f'pdo answer {repo} {num} "<text>" --project {p}'})
    for r in out:
        r["questions"] = [q for q in r["questions"] if not filler(q)]
        first = (r["questions"] or [{}])[0]
        r["question"] = " ".join((first.get("question") or (r.get("gate") or {}).get("name") or "").split())
        r["repo"], r["issue"] = (r["agent"].split("#")[0], int(r["agent"].split("#")[1])) if r["agent"] else (None, None)
        r["recommended"] = [recommended(q) for q in r["questions"]]
        r["url_kind"] = url_kind(r.get("url"))
        r.setdefault("desk", False)
        r.setdefault("live_state", None)
        if len(r["questions"]) > 1:
            r["answer_format"] = "Q<n>=<option number or your own words>, one per question, separated by '; '"
            fill = "; ".join(f"Q{i}={pick or '?'}" for i, pick in enumerate(
                (next((j for j, o in enumerate(q["options"], 1) if o["label"] == rec), None) for q, rec in zip(r["questions"], r["recommended"])), 1))
        else:
            r["answer_format"] = "an option number or your own words"
            fill = "<text>"
        r["answer"] = r["answer"].replace('"<text>"', f'"{fill}"')
        cfg, _ = pdo_config.try_load(r["project"])
        r["issue_url"] = f"https://github.com/{cfg['org']}/{r['repo']}/issues/{r['issue']}" if cfg and r["repo"] else None
        r["route"], r["route_why"] = ("human", None) if not (r["agent"] and cfg) else \
            pdo_config.design_lead_route(cfg, r["agent"].split("#")[0], int(r["agent"].split("#")[1]), r["hours"])
        r["command"] = r["answer"]
        if r["route"] == "design-lead":
            r["answer"] = f'{cfg["design_lead"]["name"]} answers it' + (" (held: asked by peer message)" if r["state"] == "held" else "")
    if only_repo:
        out = [r for r in out if r["agent"] and r["agent"].split("#")[0] == only_repo]
    out.sort(key=lambda x: -(x["hours"] or 0))
    return out


def text(rows):
    if not rows:
        return "no agent is waiting on a question"
    lines = []
    for r in rows:
        waited = f"{r['hours']:g}h" if r["hours"] is not None else "?"
        where = r["project"] + (f"/{r['repo']}" if r.get("repo") else "")
        state = r["state"] + (f": {r['live_state']}" if r.get("live_state") else "")
        lines.append(f"{r['workspace']} ({where}, {state}, waiting {waited})" + (f"  {r['issue_url']}" if r.get("issue_url") else "")
                     + (" → Design Lead" if r.get("route") == "design-lead" else ""))
        if r.get("gate"):
            lines.append(f"  gate ({r['gate']['kind']}): {r['gate']['name']}" + ("  [answer at the desk]" if r.get("desk") else ""))
        if r.get("url") and r["url"] != r.get("issue_url"):
            lines.append(f"  look at ({r['url_kind']}): {r['url']}")
        if r.get("route_why"):
            lines.append(f"  for the human: {r['route_why']}")
        many = len(r["questions"]) > 1
        for n, (q, rec) in enumerate(zip(r["questions"], r["recommended"]), 1):
            head = (f"Q{n}" if many else "Q") + (f" [{q['header']}]" if many and q.get("header") else "")
            lines.append(f"  {head}: {q['question']}" + (" (several allowed)" if q.get("multiSelect") else ""))
            for i, o in enumerate(q["options"], 1):
                lines.append(f"     {i}. {o['label']}" + (f": {o['description']}" if o.get("description") else ""))
            if rec:
                lines.append(f"     recommended: {rec}")
        if r.get("gate") and not r["questions"]:
            lines.append("  no questions recorded for this gate: read the link above")
        elif not r["questions"] and r["screen"]:
            lines += ["  screen: " + ln for ln in r["screen"].splitlines()]
        if many:
            lines.append(f"  answer format: {r['answer_format']}")
        lines.append(f"  answer: {r['answer']}")
    return "\n".join(lines)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--project")
    ap.add_argument("--repo")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()
    rows = collect(a.project, only_repo=a.repo)
    print(json.dumps({"questions": rows}, indent=1) if a.json else text(rows))


if __name__ == "__main__":
    main()
