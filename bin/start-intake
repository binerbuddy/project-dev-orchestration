#!/usr/bin/env bash
# start-intake — open the standing "intake" herdr workspace (agent name "intake") running the intake
# skill (INTAKE_SKILL, default ${PDO_SKILL_PREFIX}project-intake). Other agents queue reports with bin/intake-submit; a bare
# start only reports the inbox count. The human runs "<intake skill> inbox" there to triage them, when
# they have time. The agent runs in CONTROL_DIR (default: the config dir holding the project env).
#
# Usage: start-intake [--project P] [--model opus]

set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
die() { echo "start-intake: $*" >&2; exit 1; }
# shellcheck source=lib.sh
source "$HERE/bin/lib.sh"

PROJECT="" MODEL=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --project) PROJECT="$2"; shift 2 ;;
    --model) MODEL="$2"; shift 2 ;;
    *) die "unknown option: $1" ;;
  esac
done
pdo_resolve_project "$PROJECT"
# shellcheck source=/dev/null
HERE="$PDO_ENV_DIR" source "$PDO_ENV_FILE"; pdo_finalize
MODEL="${MODEL:-$DEFAULT_MODEL}"
NAME="intake"
# intake serves every project: its own workspace, not a tab in a project's home
pdo_standing "$NAME" "" || die "could not open a herdr workspace for \"$NAME\""
PANE_ID="$STAND_PANE"
if (( STAND_ALIVE )); then
  echo "intake agent already running in $STAND_WHERE"
  exit 0
fi
set +e; launch_agent "$PANE_ID" "$CONTROL_DIR" "$NAME" "$MODEL" "$INTAKE_SKILL"; rc=$?; set -e
[[ $rc -eq 0 ]] || die "intake agent did not start cleanly (rc=$rc); see $STAND_WHERE"
herdr agent rename "$PANE_ID" intake >/dev/null 2>&1 || true
echo "intake agent running in $STAND_WHERE"
