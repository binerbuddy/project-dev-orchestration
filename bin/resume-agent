#!/usr/bin/env bash
# resume-agent — deliver a prompt to an issue's command agent, bringing it back if it's gone.
#
# Usage: resume-agent <repo> <issue#> (--prompt TEXT | --prompt-file F) [--project P] [--model M]
#
#  - Alive (a tab with its name, or an old-layout workspace): prompts the agent in place. Refuses
#    (exit 3) while a question is pending on its screen, since typing would answer that question
#    with the wrong text.
#  - Gone (including an agent released by bin/hibernate): recreates the worktree from the branch if
#    needed, opens a tab with the same name in its manager's home (pdo_home_of; an old-layout agent
#    moves there), and resumes the SAME Claude session (`claude --resume <id>`) so the agent keeps its
#    context. Without a recorded session it starts fresh, pointed at its dispatch brief.
# Prints a JSON line: {action: prompted|resumed|restarted, workspace_id, pane_id}.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
die() { echo "resume-agent: $*" >&2; exit "${2:-1}"; }
# shellcheck source=lib.sh
source "$HERE/bin/lib.sh"

PROJECT="" PROMPT="" MODEL=""
[[ $# -ge 2 ]] || die "usage: resume-agent <repo> <issue#> (--prompt TEXT | --prompt-file F)"
REPO="$1" NUM="${2#\#}"; shift 2
while [[ $# -gt 0 ]]; do
  case "$1" in
    --prompt) PROMPT="$2"; shift 2 ;;
    --prompt-file) PROMPT="$(cat "$2")"; shift 2 ;;
    --project) PROJECT="$2"; shift 2 ;;
    --model) MODEL="$2"; shift 2 ;;
    *) die "unknown option: $1" ;;
  esac
done
[[ -n "$PROMPT" ]] || die "a --prompt or --prompt-file is required"
# shellcheck source=lib.sh
source "$HERE/bin/lib.sh"
pdo_resolve_project "$PROJECT"
# shellcheck source=/dev/null
HERE="$PDO_ENV_DIR" source "$PDO_ENV_FILE"; pdo_finalize
MODEL="${MODEL:-$DEFAULT_MODEL}"
META_FILE="$PDO_STATE_DIR/agents/$REPO-$NUM.json"
[[ -f "$META_FILE" ]] || die "no agent metadata for $REPO#$NUM (run bin/agent-meta backfill, or spawn it)"
META="$(cat "$META_FILE")"
m() { jq -r --arg k "$1" '.[$k] // empty' <<<"$META"; }

# --- alive: prompt in place ---
# find it by name (its tab label, or an old-layout workspace label): herdr reuses ids after a close,
# and a stale id once sent one agent's prompt into another agent's live session
SLOT="$(pdo_find "$(m name)" 2>/dev/null || true)"
WS_ID="" PANE_ID=""
if [[ -n "$SLOT" ]] && jq -e '.agent.agent == "claude"' >/dev/null <<<"$SLOT"; then
  WS_ID="$(jq -r .workspace_id <<<"$SLOT")" PANE_ID="$(jq -r .pane_id <<<"$SLOT")"
fi
if [[ -n "$WS_ID" && -n "$PANE_ID" ]]; then
  SCREEN="$(herdr pane read "$PANE_ID" | tail -40)"
  STATUS="$(jq -r '.agent.agent_status // .status' <<<"$SLOT")"
  if [[ "$STATUS" == blocked ]] || grep -qE "Enter to select|Do you want to proceed" <<<"$SCREEN"; then
    die "$REPO#$NUM has a question pending in \"$(m name)\"; answer it first" 3
  fi
  if DRAFT="$("$HERE/bin/herdr-agent" draft --pane "$PANE_ID")"; then  # a person's unsent text, not Claude Code's dim suggestion
    die "$REPO#$NUM has unsent text in its input box in \"$(m name)\" (${DRAFT#draft: }); send or clear it first" 3
  fi
  herdr agent prompt "$PANE_ID" "$PROMPT" >/dev/null
  jq -cn --arg name "$(m name)" --arg ws "$WS_ID" --arg pane "$PANE_ID" '{action: "prompted", workspace: $name, workspace_id: $ws, pane_id: $pane}'
  exit 0
fi

# --- gone: rebuild its place ---
ROOT="${REPO_ROOT[$REPO]}"
CWD="$(m cwd)"; CWD="${CWD:-$(m worktree)}"
BRANCH="$(m branch)"
NAME="$(m name)"; NAME="${NAME:-$REPO-$NUM resumed}"
if [[ ! -d "$CWD" ]]; then
  [[ -n "$BRANCH" ]] || die "worktree $CWD is gone and no branch is recorded"
  CWD="${CWD:-${WORKTREE_PARENT[$REPO]}/$NUM-resumed}"
  mkdir -p "$(dirname "$CWD")"
  git -C "$ROOT" fetch -q origin "+refs/heads/$BRANCH:refs/remotes/origin/$BRANCH" 2>/dev/null || true
  if git -C "$ROOT" show-ref --verify --quiet "refs/heads/$BRANCH"; then
    git -C "$ROOT" worktree add -q "$CWD" "$BRANCH"
  else
    git -C "$ROOT" worktree add -q -b "$BRANCH" "$CWD" "origin/$BRANCH"
  fi
fi

# node_modules from the shared cache (also migrates an old link to the main worktree's)
pdo_deps_link_bg "$REPO" "$CWD" "$REPO-$NUM"

# reopen it as a tab in its manager's home (an old-layout agent moves into the home here)
HOME_WS="$(pdo_home_of "$REPO")"
pdo_place "$HOME_WS" "$NAME" "$CWD" || die "could not open a herdr tab for $NAME in \"$HOME_WS\""
WS_ID="$PLACE_WS" TAB_ID="$PLACE_TAB" PANE_ID="$PLACE_PANE"
SESSION="$(m session_id)"
ACTION=resumed
if [[ -n "$SESSION" ]]; then
  set +e; launch_agent "$PANE_ID" "$CWD" "$NAME" "$MODEL" "$PROMPT" --resume "$SESSION"; rc=$?; set -e
else
  ACTION=restarted
  BRIEF="$PDO_STATE_DIR/briefs/$REPO-$NUM.md"
  FRESH="You are resuming as the command agent for $ORG/$REPO#$NUM (branch $BRANCH). Your previous session is gone.$([[ -f "$BRIEF" ]] && echo " Read your dispatch brief first: $BRIEF.") Then: $PROMPT"
  set +e; launch_agent "$PANE_ID" "$CWD" "$NAME" "$MODEL" "$FRESH"; rc=$?; set -e
fi
[[ $rc -eq 0 ]] || die "agent in tab \"$NAME\" did not come up cleanly (rc=$rc)"
herdr agent rename "$PANE_ID" "$(tr 'A-Z' 'a-z' <<<"$REPO" | tr -cd 'a-z0-9-' | cut -c1-24)-$NUM" >/dev/null 2>&1 || true
write_meta "$REPO" "$NUM" "$(jq -n --arg ws "$WS_ID" --arg tab "$TAB_ID" --arg home "$HOME_WS" --arg pane "$PANE_ID" \
  --arg cwd "$CWD" --arg session "$(session_of "$PANE_ID")" '{workspace_id: $ws, tab_id: $tab, home: $home, pane_id: $pane,
    cwd: $cwd, session_id: $session, hibernated_at: null}')"
jq -cn --arg a "$ACTION" --arg name "$NAME" --arg ws "$WS_ID" --arg pane "$PANE_ID" '{action: $a, workspace: $name, workspace_id: $ws, pane_id: $pane}'
