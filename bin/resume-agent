#!/usr/bin/env bash
# resume-agent — deliver a prompt to an issue's command agent, bringing it back if it's gone.
#
# Usage: resume-agent <repo> <issue#> (--prompt TEXT | --prompt-file F) [--project P] [--model M]
#
#  - Workspace alive: prompts the agent in place. Refuses (exit 3) while a question is pending on
#    its screen, since typing would answer that question with the wrong text.
#  - Workspace closed (including an agent released by bin/hibernate): recreates the worktree from the branch if needed, opens a workspace with
#    the same name, and resumes the SAME Claude session (`claude --resume <id>`) so the agent
#    keeps its context. Without a recorded session it starts fresh, pointed at its dispatch brief.
# Prints a JSON line: {action: prompted|resumed|restarted, workspace_id, pane_id}.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
die() { echo "resume-agent: $*" >&2; exit "${2:-1}"; }
# shellcheck source=lib.sh
source "$HERE/bin/lib.sh"

PROJECT="" PROMPT="" MODEL=""
[[ $# -ge 2 ]] || die "usage: resume-agent <repo> <issue#> (--prompt TEXT | --prompt-file F)"
REPO="$1" NUM="${2#\#}"; shift 2
while [[ $# -gt 0 ]]; do
  case "$1" in
    --prompt) PROMPT="$2"; shift 2 ;;
    --prompt-file) PROMPT="$(cat "$2")"; shift 2 ;;
    --project) PROJECT="$2"; shift 2 ;;
    --model) MODEL="$2"; shift 2 ;;
    *) die "unknown option: $1" ;;
  esac
done
[[ -n "$PROMPT" ]] || die "a --prompt or --prompt-file is required"
# shellcheck source=lib.sh
source "$HERE/bin/lib.sh"
pdo_resolve_project "$PROJECT"
# shellcheck source=/dev/null
HERE="$PDO_ENV_DIR" source "$PDO_ENV_FILE"; pdo_finalize
MODEL="${MODEL:-$DEFAULT_MODEL}"
META_FILE="$PDO_STATE_DIR/agents/$REPO-$NUM.json"
[[ -f "$META_FILE" ]] || die "no agent metadata for $REPO#$NUM (run bin/agent-meta backfill, or spawn it)"
META="$(cat "$META_FILE")"
m() { jq -r --arg k "$1" '.[$k] // empty' <<<"$META"; }

# --- alive: prompt in place ---
WS_ID="$(m workspace_id)"
# herdr reuses workspace ids after a close: trust the stored id only while that workspace still
# carries this agent's name (a stale id once sent one agent's prompt into another agent's live session)
if [[ -n "$WS_ID" ]] && ! herdr workspace list | jq -e --arg w "$WS_ID" --arg n "$(m name)" \
     '.result.workspaces[] | select(.workspace_id == $w and .label == $n)' >/dev/null; then
  WS_ID=""
fi
PANE_ID=""
if [[ -n "$WS_ID" ]]; then
  PANE_ID="$(herdr agent list | jq -r --arg w "$WS_ID" '[.result.agents[] | select(.workspace_id == $w and .agent == "claude") | .pane_id][0] // empty')"
fi
if [[ -n "$WS_ID" && -n "$PANE_ID" ]]; then
  SCREEN="$(herdr pane read "$PANE_ID" | tail -40)"
  STATUS="$(herdr agent list | jq -r --arg p "$PANE_ID" '.result.agents[] | select(.pane_id == $p) | .agent_status')"
  if [[ "$STATUS" == blocked ]] || grep -qE "Enter to select|Do you want to proceed" <<<"$SCREEN"; then
    die "$REPO#$NUM has a question pending in workspace $WS_ID; answer it first" 3
  fi
  herdr agent prompt "$PANE_ID" "$PROMPT" >/dev/null
  jq -cn --arg name "$(m name)" --arg ws "$WS_ID" --arg pane "$PANE_ID" '{action: "prompted", workspace: $name, workspace_id: $ws, pane_id: $pane}'
  exit 0
fi

# --- gone: rebuild the workspace ---
ROOT="${REPO_ROOT[$REPO]}"
CWD="$(m cwd)"; CWD="${CWD:-$(m worktree)}"
BRANCH="$(m branch)"
NAME="$(m name)"; NAME="${NAME:-$REPO-$NUM resumed}"
if [[ ! -d "$CWD" ]]; then
  [[ -n "$BRANCH" ]] || die "worktree $CWD is gone and no branch is recorded"
  CWD="${CWD:-$ROOT/$NUM-resumed}"
  git -C "$ROOT" fetch -q origin "+refs/heads/$BRANCH:refs/remotes/origin/$BRANCH" 2>/dev/null || true
  if git -C "$ROOT" show-ref --verify --quiet "refs/heads/$BRANCH"; then
    git -C "$ROOT" worktree add -q "$CWD" "$BRANCH"
  else
    git -C "$ROOT" worktree add -q -b "$BRANCH" "$CWD" "origin/$BRANCH"
  fi
fi

WS_ID="$(herdr workspace create --cwd "$CWD" --label "$NAME" --no-focus | jq -r '[.. | objects | .workspace_id? // empty][0]')"
PANE_ID="$(herdr pane list --workspace "$WS_ID" | jq -r '.result.panes[0].pane_id')"
SESSION="$(m session_id)"
ACTION=resumed
if [[ -n "$SESSION" ]]; then
  set +e; launch_agent "$PANE_ID" "$CWD" "$NAME" "$MODEL" "$PROMPT" --resume "$SESSION"; rc=$?; set -e
else
  ACTION=restarted
  BRIEF="$PDO_STATE_DIR/briefs/$REPO-$NUM.md"
  FRESH="You are resuming as the command agent for $ORG/$REPO#$NUM (branch $BRANCH). Your previous session is gone.$([[ -f "$BRIEF" ]] && echo " Read your dispatch brief first: $BRIEF.") Then: $PROMPT"
  set +e; launch_agent "$PANE_ID" "$CWD" "$NAME" "$MODEL" "$FRESH"; rc=$?; set -e
fi
[[ $rc -eq 0 ]] || die "agent in workspace $WS_ID did not come up cleanly (rc=$rc)"
herdr agent rename "$PANE_ID" "$(tr 'A-Z' 'a-z' <<<"$REPO" | tr -cd 'a-z0-9-' | cut -c1-24)-$NUM" >/dev/null 2>&1 || true
write_meta "$REPO" "$NUM" "$(jq -n --arg ws "$WS_ID" --arg pane "$PANE_ID" --arg cwd "$CWD" \
  --arg session "$(session_of "$PANE_ID")" '{workspace_id: $ws, pane_id: $pane, cwd: $cwd, session_id: $session,
    hibernated_at: null}')"
jq -cn --arg a "$ACTION" --arg name "$NAME" --arg ws "$WS_ID" --arg pane "$PANE_ID" '{action: $a, workspace: $name, workspace_id: $ws, pane_id: $pane}'
