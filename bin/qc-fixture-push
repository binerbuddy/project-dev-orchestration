#!/usr/bin/env bash
# qc-fixture-push — publish a QC fixture archive to the never-merged `qc-fixtures` branch.
#
# Usage: qc-fixture-push <pr#> <file> [--name NAME] [--repo R] [--project P]
#        (--repo defaults to the project's PRIMARY_REPO)
#
# Stores <file> at `<pr#>/<NAME>` (default: the file's basename) on the fixture branch
# (FIXTURE_BRANCH, default `qc-fixtures`) and prints its
# download URL for the QC checklist's "Test data" item. Fixtures never go on PR branches: they
# would merge into main with the PR. Uses git plumbing against the clone root (no worktree, no
# checkout), creates the orphan branch if it doesn't exist, and retries when another agent pushed
# first. Re-pushing the same path replaces the file. FIXTURE_EXT (e.g. `.tar.gz`) names the
# project's fixture format: a file with another extension is pushed with a warning.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
die() { echo "qc-fixture-push: $*" >&2; exit 1; }
PROJECT="" REPO="" PR="" FILE="" NAME=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) REPO="$2"; shift 2 ;;
    --project) PROJECT="$2"; shift 2 ;;
    --name) NAME="$2"; shift 2 ;;
    -h|--help) sed -n '2,13p' "$0"; exit 0 ;;
    *) if [[ -z "$PR" ]]; then PR="${1#\#}"; else FILE="$1"; fi; shift ;;
  esac
done
[[ "$PR" =~ ^[0-9]+$ && -n "$FILE" ]] || die "usage: qc-fixture-push <pr#> <file> [--name NAME]"
[[ -f "$FILE" ]] || die "no such file: $FILE"
NAME="${NAME:-$(basename "$FILE")}"
[[ "$NAME" =~ ^[A-Za-z0-9._-]+$ ]] || die "bad name: $NAME (letters, digits, . _ - only)"
size=$(stat -c %s "$FILE")
(( size <= 5 * 1024 * 1024 )) || echo "qc-fixture-push: warning: $NAME is $((size / 1048576)) MB (keep fixtures under ~5 MB)" >&2
# shellcheck source=lib.sh
source "$HERE/bin/lib.sh"
pdo_resolve_project "$PROJECT"
# shellcheck source=/dev/null
HERE="$PDO_ENV_DIR" source "$PDO_ENV_FILE"; pdo_finalize
REPO="${REPO:-$PRIMARY_REPO}"
[[ -n "$REPO" ]] || die "pass --repo (the project has no PRIMARY_REPO)"
if [[ -n "$FIXTURE_EXT" && "$NAME" != *"$FIXTURE_EXT" ]]; then
  echo "qc-fixture-push: warning: $NAME does not end in $FIXTURE_EXT (the project's fixture format)" >&2
fi
export GIT_DIR="${REPO_ROOT[$REPO]:?unknown repo $REPO}"
[[ -d "$GIT_DIR/worktrees" || -f "$GIT_DIR/HEAD" ]] || GIT_DIR="$GIT_DIR/.git"
BR="$FIXTURE_BRANCH"
REF="refs/remotes/origin/$BR"
IDX="$(mktemp)"; trap 'rm -f "$IDX"' EXIT

blob=$(git hash-object -w -- "$FILE")
for attempt in 1 2 3 4 5; do
  git fetch -q origin "+refs/heads/$BR:$REF" 2>/dev/null || git update-ref -d "$REF" 2>/dev/null || true
  rm -f "$IDX"
  if git rev-parse -q --verify "$REF^{commit}" >/dev/null; then
    GIT_INDEX_FILE="$IDX" git read-tree "$REF"; parent=(-p "$REF")
  else
    GIT_INDEX_FILE="$IDX" git read-tree --empty; parent=()   # first fixture ever: orphan branch
    readme=$(printf '%s\n' "# QC fixtures" "" \
      "Never merged. Test data for human QC, one folder per PR: \`<PR#>/<name>${FIXTURE_EXT}\`." \
      "Published with project-dev-orchestration \`bin/qc-fixture-push\`. How to load a fixture is in each PR's QC checklist." \
      | git hash-object -w --stdin)
    GIT_INDEX_FILE="$IDX" git update-index --add --cacheinfo "100644,$readme,README.md"
  fi
  GIT_INDEX_FILE="$IDX" git update-index --add --cacheinfo "100644,$blob,$PR/$NAME"
  tree=$(GIT_INDEX_FILE="$IDX" git write-tree)
  if [[ ${#parent[@]} -gt 0 && "$tree" == "$(git rev-parse "$REF^{tree}")" ]]; then
    echo "unchanged"; break
  fi
  commit=$(git commit-tree "$tree" "${parent[@]}" -m "qc: fixture $NAME for PR #$PR")
  if git push -q origin "$commit:refs/heads/$BR" 2>/dev/null; then
    git update-ref "$REF" "$commit"; break
  fi
  [[ $attempt -lt 5 ]] || die "push failed after 5 attempts"
  sleep $((attempt * 2))
done
org="$ORG"
echo "https://github.com/$org/$REPO/blob/$BR/$PR/$NAME"
echo "raw: https://github.com/$org/$REPO/raw/$BR/$PR/$NAME"
