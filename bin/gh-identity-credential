#!/usr/bin/env bash
# gh-identity-credential — git credential helper that answers as one gh login: gh-identity-credential <login> <op>
# PDO_GH_IDENTITY_SHIM (marker: never mistaken for the real gh)
#
# `pdo install --gh-identities` wires it per owner in gitconfig-identities:
#   [credential "https://github.com/<owner>"]
#       helper =
#       helper = "!'<this file>' <login>"
#       useHttpPath = true
# get: prints username=<login> and password=$(gh auth token -u <login>) (a local lookup; GH_TOKEN
# and GITHUB_TOKEN are ignored so the answer is always that login's token). store / erase: ignored,
# since gh owns the token. When the login has no token it prints nothing, so git falls through.
set -uo pipefail
login="${1:-}" op="${2:-}"
[[ -n "$login" ]] || { echo "usage: gh-identity-credential <login> get|store|erase" >&2; exit 2; }
cat >/dev/null  # git sends the request on stdin; the login alone decides the answer
[[ "$op" == get ]] || exit 0
token="$(env -u GH_TOKEN -u GITHUB_TOKEN PDO_GH_SHIM=off gh auth token -u "$login" 2>/dev/null)" || token=""
[[ -n "$token" ]] || exit 0
printf 'username=%s\npassword=%s\n' "$login" "$token"
