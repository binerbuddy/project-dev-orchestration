#!/usr/bin/env bash
# ext-review — run an outside model as one extra reviewer of a PR review (project-pr-review), read-only.
#
# Usage: ext-review codex --worktree <dir> --diff <file> --prompt-file <file> --out <file> [--timeout <s>]
#
# The reviewer reads the diff and the worktree and writes its findings to --out; nothing else. It runs
# with `codex exec --sandbox read-only` (no writes, no network for its commands), ephemeral (no session
# kept), and with no GitHub credentials in its environment (GH_TOKEN/GITHUB_TOKEN unset, an empty gh
# config dir, git prompts off), so it can't push, comment or merge even if it tried. The diff and
# files it reads go to the model's provider: never use it on a diff with real data or fixtures.
# Prints one JSON line: {reviewer, out, seconds, rc, tokens} (tokens from its --json usage events, if any).
set -euo pipefail
die() { echo "ext-review: $*" >&2; exit 2; }
WHO="${1:-}"; shift || true
WT="" DIFF="" PROMPT="" OUT="" TIMEOUT=1200
while [[ $# -gt 0 ]]; do
  case "$1" in
    --worktree) WT="$2"; shift 2 ;;
    --diff) DIFF="$2"; shift 2 ;;
    --prompt-file) PROMPT="$2"; shift 2 ;;
    --out) OUT="$2"; shift 2 ;;
    --timeout) TIMEOUT="$2"; shift 2 ;;
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
done
[[ "$WHO" == codex ]] || die "unknown reviewer '$WHO' (supported: codex)"
[[ -d "$WT" && -f "$DIFF" && -f "$PROMPT" && -n "$OUT" ]] || die "usage: ext-review codex --worktree <dir> --diff <file> --prompt-file <file> --out <file>"
command -v codex >/dev/null || die "codex isn't installed"
EMPTY_GH="$(mktemp -d)"; trap 'rm -rf "$EMPTY_GH"' EXIT
TASK="$(cat "$PROMPT")

The PR's diff is in $DIFF. The repo at that PR's head is your working directory ($WT): read any file
there for context. You are read-only: never write files, run builds or installs, or use git or gh to
change anything. Verify every claim against the code. Write ONLY your findings as your final
message, one per item, each with: severity (Critical/High/Medium/Low), file:line, the issue in one
sentence, a concrete failure scenario, and a suggested fix. If you find nothing significant, say
\"No findings.\""
start=$(date +%s)
set +e
env -u GH_TOKEN -u GITHUB_TOKEN GH_CONFIG_DIR="$EMPTY_GH" GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/bin/false \
  timeout "$TIMEOUT" codex exec --sandbox read-only --skip-git-repo-check --ephemeral --json -C "$WT" \
  -o "$OUT" "$TASK" </dev/null >"$OUT.events.jsonl" 2>"$OUT.stderr"
rc=$?
set -e
secs=$(( $(date +%s) - start ))
tokens="$(jq -s '[.[] | (.usage // .msg.usage // .info.total_token_usage // empty) | (.total_tokens // ((.input_tokens // 0) + (.output_tokens // 0)))] | max // null' "$OUT.events.jsonl" 2>/dev/null || echo null)"
jq -cn --arg out "$OUT" --argjson secs "$secs" --argjson rc "$rc" --argjson tokens "${tokens:-null}" \
  '{reviewer: "codex", out: $out, seconds: $secs, rc: $rc, tokens: $tokens}'
exit "$rc"
