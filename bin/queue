#!/usr/bin/env python3
"""queue — deterministic work queue for the orchestrator (no model judgement).

Usage: queue [--project P] [--repo NAME] [--limit N] [--json] [--all]

Ranking uses only the human's vocabulary: P-levels (P1-urgent … P4-low; unlabelled sorts
after P4) and Claude Work This (CWT).
  - CWT items come first, then by P-level.
  - Within a P-level: Security-labelled, then Bugs (logic bugs), then the rest.
Auto-spawn (auto_spawn: true): CWT, P1, P2, P3. Only P4 and unprioritised items wait for `drain`.
Priority inheritance: an issue that blocks others runs at the best P-level (and CWT) among the
issues it transitively holds up, when being blocked is their only exclusion: "a P4 blocking a
P2 runs as P2". Such rows show "unblocks:#N (P4->P2)".
Spawn floor: bin/floor P2 (persisted) or --floor makes auto_spawn false for everything below the
floor, Claude Work This included; below_floor marks those rows. The urgent bypass is unaffected.
Urgent bypass: an item that is P1-urgent AND on Claude Work This is flagged urgent_bypass; the
orchestrator starts it even with no free slot and over the usage ceiling.
Fleet advice (soft): with FLEET_ADVICE=honour in the project env and a fresh (< 2 h)
$PDO_STATE_DIR/fleet-advice.json from `fleet --write-advice`, "hold" makes auto_spawn false
(fleet_hold) for everything except the urgent bypass, and suggested_max_active caps max_active
below MAX_ACTIVE. With the default FLEET_ADVICE=ignore the advice is only shown in the summary.
Board-less mode (no PROJECT_NUMBER): the queue is the open issues labelled QUEUE_LABEL (default
"queue:work"), ranked the same way without the board's columns: no CWT, no board-status exclusions
(the managed-by claim label marks work in progress). A blocker of a queued issue joins the queue
through priority inheritance even without the label.
Further tie-breaks: parent epic In Progress, oldest first
(original creation date when the issue was migrated from another tracker).

Excluded (listed with --all): assigned (human/interactive lock), managed-by:<slug> (another
manager's claim label; this project's own label shows as "claimed": already in progress), on-hold, likely-fixed, epic-phase (a phase is run by its
parent Epic's build agent, never on its own), a spawn failure in the last 24h, needs-triage, blocked by
an open issue (GitHub's native "blocked by": reason blocked-by:<ref>, the open blockers read in one
batched GraphQL query per repo, only for issues whose dependency summary shows open blockers), already In Progress / In Review / Done on the board, an open herdr workspace
for the issue, Epics without a route:* label (containers, not work items), and
orchestrator-system issues (work on the orchestrator itself; the System Manager owns those,
named by SYSTEM_MANAGER_WORKSPACE).
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time

sys.dont_write_bytecode = True  # keep the engine checkout free of __pycache__
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import pdo_config  # noqa: E402

HERE = pdo_config.ENGINE_HOME
CFG = {}  # the resolved project config, set by load_env()
BOARD_LIMIT = 2000
# defaults; the project's P_LABELS (best first) and CWT_STATUS replace them in load_env()
PRIORITIES = {"P1-urgent": 1, "P2-high": 2, "P3-medium": 3, "P4-low": 4}
CWT = "Claude Work This"
NO_PRIORITY = 5   # sorts after P4; shown as "P-" (unprioritised)
AUTO_MAX_P = 3    # P1–P3 auto-spawn; P4 and unprioritised wait for `drain`


def read_floor(project, override=None):
    """The spawn floor as a P-level number (5 = none). --floor overrides the persisted bin/floor value."""
    v = override
    if v is None:
        try:
            v = open(os.path.join(pdo_config.state_dir(), f"{project}-floor"), encoding="utf-8").read().strip()
        except OSError:
            v = ""
    v = (v or "").upper()
    return int(v[1]) if re.fullmatch(r"P[1-4]", v) else NO_PRIORITY


def p_name(level):
    return f"P{level}" if level < NO_PRIORITY else "P-"
IN_FLIGHT = {"In Progress", "In Review", "Done"}


def sh(*args):
    r = subprocess.run(args, capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"queue: {' '.join(args[:3])}… failed: {r.stderr.strip()}")
    return r.stdout


def load_env(project):
    """ORG, PROJECT_NUMBER (None in board-less mode) and the repos this orchestrator manages
    (REPO_ROOT minus SELF_MANAGED_REPOS, which another manager owns end to end)."""
    global PRIORITIES, CWT
    CFG.update(pdo_config.load(project, "queue"))
    PRIORITIES = {l: i + 1 for i, l in enumerate(CFG["p_labels"])}
    CWT = CFG["cwt_status"]
    num = CFG["project_number"] or ""
    if num and not re.fullmatch(r"\d+", num):
        sys.exit(f"queue: project '{CFG['project']}' has a bad PROJECT_NUMBER: {num}")
    if not num and not CFG.get("queue_label"):
        sys.exit(f"queue: project '{CFG['project']}' has no PROJECT_NUMBER (board) and no QUEUE_LABEL (board-less queue)")
    managed = set(CFG["self_managed_repos"])
    return CFG["org"], CFG["project_number"], [r for r in CFG["repo_root"] if r not in managed]


def board_items(org, num):
    data = json.loads(sh("gh", "project", "item-list", num, "--owner", org,
                         "--format", "json", "--limit", str(BOARD_LIMIT)))
    items = data["items"]
    if len(items) >= BOARD_LIMIT:
        sys.exit(f"queue: board returned {len(items)} items = limit; raise BOARD_LIMIT (truncation guard)")
    out = {}
    for it in items:
        c = it.get("content") or {}
        repo = (it.get("repository") or "").rsplit("/", 1)[-1]
        if c.get("number"):
            out[(repo, c["number"])] = it.get("status")
    return out


def open_issues(org, repo):
    raw = sh("gh", "api", f"repos/{org}/{repo}/issues?state=open&per_page=100", "--paginate",
             "--jq", ".[] | select(.pull_request | not)")
    return [json.loads(line) for line in raw.splitlines() if line.strip()]


def herdr_workspaces():
    try:
        r = subprocess.run(["herdr", "workspace", "list"], capture_output=True, text=True, timeout=10)
        return [w["label"] for w in json.loads(r.stdout)["result"]["workspaces"]]
    except Exception:
        return []  # herdr not running: no workspace-based exclusion


FAIL_LOG = None  # $PDO_STATE_DIR/spawn-failures.jsonl, set in main() once the state dir is known
FAIL_SKIP_SEC = 24 * 3600


def recent_failures():
    """(repo, number) -> last error, for spawn failures within FAIL_SKIP_SEC."""
    out, now = {}, time.time()
    try:
        for line in open(FAIL_LOG or os.path.join(pdo_config.state_dir(), "spawn-failures.jsonl"), encoding="utf-8"):
            try:
                f = json.loads(line)
            except ValueError:
                continue
            if now - f.get("at", 0) < FAIL_SKIP_SEC:
                out[(f["repo"], f["number"])] = f.get("error", "")
    except FileNotFoundError:
        pass
    return out


def inherit_priority(org, rows):
    """Priority inheritance: a blocker runs at the best P-level (and CWT) of what it holds up.

    Without this, a P4 blocking a P2 deadlocks: the P2 is excluded as blocked, and the P4 only
    runs with `drain`. A blocked issue passes its level on only when being blocked is its sole
    exclusion (it would run otherwise); applied transitively, so Z blocks A blocks B lifts Z.
    """
    by_key = {(r["repo"], r["number"]): r for r in rows}
    blocks = {}
    for r in rows:
        if r["blocking"]:
            raw = sh("gh", "api", f"repos/{org}/{r['repo']}/issues/{r['number']}/dependencies/blocking",
                     "--jq", r'.[] | select(.state == "open") | "\(.repository_url | split("/") | .[-1]) \(.number)"')
            blocks[(r["repo"], r["number"])] = [(ln.split()[0], int(ln.split()[1])) for ln in raw.splitlines() if ln.strip()]

    def wants_to_run(r):
        return all(x.startswith("blocked-by:") for x in r["excluded"])

    def lift(r):  # board-less mode: a blocker of queued work is queued work
        if "not-queued" in r["excluded"]:
            r["excluded"].remove("not-queued")
            return True
        return False

    changed = True
    while changed:  # fixpoint over the (small) blocking graph
        changed = False
        for key, targets in blocks.items():
            r = by_key.get(key)
            if not r:
                continue
            for t in targets:
                b = by_key.get(t)
                if b and wants_to_run(b) and lift(r):
                    changed = True
                if b and wants_to_run(b) and (b["p_level"] < r["p_level"] or (b["cwt"] and not r["cwt"])):
                    r["p_level"] = min(r["p_level"], b["p_level"])
                    r["cwt"] = r["cwt"] or b["cwt"]
                    changed = True
                ref = b["ref"] if b else f"{t[0]}#{t[1]}"
                if b and wants_to_run(b) and ref not in r["unblocks"]:
                    r["unblocks"].append(ref)


BLOCKERS_Q = """query blockers($o:String!,$r:String!){repository(owner:$o,name:$r){%s}}"""


def blocker_refs(org, repo, numbers):
    """{number: [ref of each OPEN native blocker]} for issues whose dependency summary says they are
    blocked, read in one GraphQL query per 50 issues (aliases; ~1 point each). None when the read
    fails (the caller falls back to the summary's count)."""
    out = {}
    nums = sorted(set(numbers))
    for i in range(0, len(nums), 50):
        part = " ".join(f"i{n}: issue(number:{n}){{blockedBy(first:20){{nodes{{number state repository{{nameWithOwner}}}}}}}}"
                        for n in nums[i:i + 50])
        r = subprocess.run(["gh", "api", "graphql", "-f", f"query={BLOCKERS_Q % part}", "-F", f"o={org}", "-F", f"r={repo}"],
                           capture_output=True, text=True)
        try:
            data = json.loads(r.stdout)["data"]["repository"]
        except (ValueError, KeyError, TypeError):
            return None
        for n in nums[i:i + 50]:
            nodes = ((data.get(f"i{n}") or {}).get("blockedBy") or {}).get("nodes") or []
            refs = []
            for b in nodes:
                if b.get("state") != "OPEN":
                    continue
                owner, _, name = (b.get("repository") or {}).get("nameWithOwner", "/").partition("/")
                refs.append(pdo_config.ref(CFG, name, b["number"]) if owner.lower() == org.lower()
                            else f"{owner}/{name}#{b['number']}")
            out[n] = refs
    return out


def origin_date(issue):
    m = re.search(r"created (\d{4}-\d{2}-\d{2}) by", issue.get("body") or "")
    return m.group(1) if m else issue["created_at"][:10]


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--project")
    ap.add_argument("--repo")
    ap.add_argument("--limit", type=int, default=15)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--all", action="store_true", help="also list excluded items with reasons")
    ap.add_argument("--floor", help="spawn floor P1..P4 or none; default: the persisted bin/floor value")
    a = ap.parse_args()

    org, num, repos = load_env(a.project)
    if a.repo:
        repos = [a.repo]
    queue_label = None if num else CFG["queue_label"]  # board-less mode: the label is the queue
    board = board_items(org, num) if num else {}
    workspaces = herdr_workspaces()
    failures = recent_failures()

    issues = []
    for repo in repos:
        for i in open_issues(org, repo):
            i["_repo"] = repo
            issues.append(i)
    by_url = {i["url"]: i for i in issues}
    # native "blocked by": the REST summary counts open blockers; name them for the reason
    blockers = {}
    for repo in repos:
        nums = [i["number"] for i in issues if i["_repo"] == repo
                and (i.get("issue_dependencies_summary") or {}).get("blocked_by")]
        if nums:
            got = blocker_refs(org, repo, nums)
            for n, refs in (got or {}).items():
                blockers[(repo, n)] = refs
    my_label = CFG.get("claim_label")

    ranked, excluded = [], []
    for i in issues:
        repo, n = i["_repo"], i["number"]
        labels = [l["name"] for l in i["labels"]]
        lower = {l.lower() for l in labels}
        status = board.get((repo, n))
        itype = (i.get("type") or {}).get("name") or "none"
        prio = next((PRIORITIES[l] for l in labels if l in PRIORITIES), None)
        security = "security" in lower
        route = next((l.split(":", 1)[1] for l in labels if l.startswith("route:")), None)
        parent = by_url.get(i.get("parent_issue_url") or "")
        parent_active = bool(parent and board.get((parent["_repo"], parent["number"])) == "In Progress")
        deps = i.get("issue_dependencies_summary") or {}
        blocked = deps.get("blocked_by", 0)
        ref = pdo_config.ref(CFG, repo, n)

        reasons = []
        if i.get("assignees"):
            reasons.append("assigned:" + ",".join(u["login"] for u in i["assignees"]))
        if status in IN_FLIGHT:
            reasons.append(f"board:{status}")
        if any(w.startswith(f"{repo}-{n} ") for w in workspaces):
            reasons.append("workspace-open")
        if "needs-triage" in lower and status != CWT:
            reasons.append("needs-triage")
        if "on-hold" in lower:
            reasons.append("on-hold")
        if "likely-fixed" in lower:
            reasons.append("likely-fixed")
        if "epic-phase" in lower:
            reasons.append("epic-phase(run parent)")
        if (repo, n) in failures:
            reasons.append("spawn-failed<24h")
        for l in labels:
            if l.lower().startswith("managed-by:"):
                # a managed-by label is a claim: ours = already in progress here; another manager's = theirs
                reasons.append("claimed" if my_label and l.lower() == my_label.lower() else l)
        if queue_label and queue_label.lower() not in lower:
            reasons.append("not-queued")  # dropped below unless inheritance lifts it as a blocker
        if blocked:
            refs = blockers.get((repo, n))
            reasons.append("blocked-by:" + (",".join(refs) if refs else str(blocked)))
        if itype == "Epic" and not route:
            reasons.append("epic-without-route")

        p_level = prio if prio is not None else NO_PRIORITY
        cwt = status == CWT
        if "orchestrator-system" in lower:
            reasons.append(f"orchestrator-system({CFG.get('system_manager_workspace') or 'System Manager'})")

        row = {
            "ref": ref, "repo": repo, "number": n, "title": i["title"], "type": itype,
            "priority": next((l for l in labels if l in PRIORITIES), None), "security": security,
            "route": route, "status": status, "p_level": p_level, "cwt": cwt, "parent_active": parent_active,
            "bug": itype == "Bug",
            "created": origin_date(i), "url": i["html_url"], "excluded": reasons,
            "own_p_level": p_level, "own_cwt": cwt, "blocking": deps.get("blocking", 0), "unblocks": [],
            # human's rule (2026-09-30): P1-urgent AND on Claude Work This starts even when every
            # slot is taken or usage is over the ceiling. Neither condition alone bypasses.
            "urgent_bypass": status == CWT and min(PRIORITIES, key=PRIORITIES.get) in labels,
        }
        (excluded if reasons else ranked).append(row)

    inherit_priority(org, ranked + excluded)
    rows = [r for r in ranked + excluded if "not-queued" not in r["excluded"]]
    ranked = [r for r in rows if not r["excluded"]]
    excluded = [r for r in rows if r["excluded"]]

    floor = read_floor(CFG["project"], a.floor)
    advice = pdo_config.fleet_advice(CFG)
    fleet_held = bool(advice and advice["honoured"] and advice.get("advice") == "hold")
    own_max = CFG.get("max_active") or 3
    max_active = own_max
    if advice and advice["honoured"] and isinstance(advice.get("suggested_max_active"), int):
        max_active = max(0, min(own_max, advice["suggested_max_active"]))  # a bound on top, never a raise
    for r in ranked + excluded:
        r["p"] = p_name(r["p_level"])
        # the floor binds CWT too (human's rule); the urgent bypass is separate and unaffected
        r["below_floor"] = r["p_level"] > floor
        # fleet "hold" (only when honoured) is soft: the urgent bypass still wins
        r["fleet_hold"] = fleet_held and not r["urgent_bypass"]
        r["auto_spawn"] = (r["cwt"] or r["p_level"] <= AUTO_MAX_P) and not r["below_floor"] and not r["fleet_hold"]

    key = lambda r: (not r["cwt"], r["p_level"], not r["security"], not r["bug"], not r["parent_active"],
                     r["created"], r["repo"], r["number"])
    ranked.sort(key=key)
    excluded.sort(key=key)

    if a.json:
        out = {"ranked": ranked[: a.limit], **({"mode": "label", "queue_label": queue_label} if queue_label else {}), "floor": p_name(floor) if floor < NO_PRIORITY else None,
               "eligible": len(ranked), "excluded_count": len(excluded), "max_active": max_active,
               "fleet": advice}
        if a.all:
            out["excluded"] = excluded
        json.dump(out, sys.stdout, indent=2)
        print()
        return

    for pos, r in enumerate(ranked[: a.limit], 1):
        lifted = r["p_level"] < r["own_p_level"] or (r["cwt"] and not r["own_cwt"])
        flags = "".join([
            " [URGENT-BYPASS]" if r["urgent_bypass"] else "", " [SEC]" if r["security"] else "",
            f" route:{r['route']}" if r["route"] else "",
            f" unblocks:{','.join(r['unblocks'])} ({p_name(r['own_p_level'])}->{r['p']})" if lifted else "",
            " epic-active" if r["parent_active"] else "",
            "" if r["auto_spawn"] else (" (below floor)" if r["below_floor"] else
                                        " (fleet hold)" if r["fleet_hold"] else " (waits for drain)")])
        print(f"{pos:>3}. {r['p']:<2} {'CWT' if r['cwt'] else '   '} {r['ref']:<22} {r['type']:<7} {r['title'][:70]}{flags}")
    fl = f"; spawn floor {p_name(floor)} (nothing below it starts, CWT included)" if floor < NO_PRIORITY else ""
    fa = ""
    if advice:
        fa = (f"; fleet: {advice.get('advice')}, max {advice.get('suggested_max_active')}"
              f" ({advice.get('reason', '')}; {advice['age_min']} min old, "
              f"{'honoured, max_active ' + str(max_active) if advice['honoured'] else 'advisory: FLEET_ADVICE=ignore'})")
    src = f"; board-less: issues labelled {queue_label}" if queue_label else ""
    print(f"     ({len(ranked)} eligible, {len(excluded)} excluded; P1-P3 and CWT auto-spawn, P4/P- wait for drain{fl}{fa}{src})")
    if a.all:
        print("\nExcluded:")
        for r in excluded:
            print(f"  {r['p']:<2} {'CWT' if r['cwt'] else '   '} {r['ref']:<22} {', '.join(r['excluded']):<34} {r['title'][:60]}")


if __name__ == "__main__":
    main()
