#!/usr/bin/env bash
# start-manager — open a project's lead, its Repo Manager (MANAGER, e.g. "Repo Manager (<project>)"),
# in tab 1 of the project's home workspace, running the project-repo-manager skill. With --repo R,
# open a self-managed repo's lead (REPO_MANAGER[R]) in tab 1 of that repo's home instead.
# It starts nothing else: the Repo Manager starts its own orchestrator, QC and QC Agent when told.
#
# Usage: start-manager [--project P] [--repo R] [--model M]
# Already running: says so. A home that exists without its manager gets the manager as a later tab
# (herdr can't reorder tabs; `pdo shutdown` the home first for a clean tab 1).
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
die() { echo "start-manager: $*" >&2; exit 1; }
# shellcheck source=lib.sh
source "$HERE/bin/lib.sh"

PROJECT="" REPO="" MODEL=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --project) PROJECT="$2"; shift 2 ;;
    --repo) REPO="$2"; shift 2 ;;
    --model) MODEL="$2"; shift 2 ;;
    -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
done
pdo_resolve_project "$PROJECT"
# shellcheck source=/dev/null
HERE="$PDO_ENV_DIR" source "$PDO_ENV_FILE"; pdo_finalize
MODEL="${MODEL:-$DEFAULT_MODEL}"
if [[ -n "$REPO" ]]; then
  [[ -n "${REPO_ROOT[$REPO]:-}" ]] || die "unknown repo '$REPO' (REPO_ROOT has: ${!REPO_ROOT[*]})"
  [[ "$(pdo_home_of "$REPO")" == "$REPO" ]] || die "$REPO is not self-managed (SELF_MANAGED_REPOS): its lead is the project's MANAGER"
  NAME="$(declare -p REPO_MANAGER >/dev/null 2>&1 && printf '%s' "${REPO_MANAGER[$REPO]:-}")"
  HOME_WS="$REPO" CWD="${REPO_ROOT[$REPO]}" AGENT="manager-$(pdo_slug "$REPO")"
  [[ -n "$NAME" ]] || die "no REPO_MANAGER[$REPO] in the project env"
else
  NAME="${MANAGER:-}" HOME_WS="$(pdo_team_home)" CWD="$CONTROL_DIR" AGENT="manager-$(pdo_slug "$PROJECT")"
  [[ -n "$NAME" ]] || die "no MANAGER in the project env (set MANAGER=\"Repo Manager ($PROJECT)\")"
  [[ "$NAME" != "Orchestrator ($PROJECT)" ]] \
    || die "MANAGER is the orchestrator: use pdo start-orchestrator, or set MANAGER=\"Repo Manager ($PROJECT)\""
fi
HOME_EXISTED=0
herdr workspace list 2>/dev/null | jq -e --arg h "$HOME_WS" '.result.workspaces[] | select(.label == $h)' >/dev/null \
  && HOME_EXISTED=1
PLACE_TAB=""
CONTROL_DIR="$CWD" pdo_standing "$NAME" "$HOME_WS" || die "could not open a herdr tab for \"$NAME\" in \"$HOME_WS\""
if (( STAND_ALIVE )); then
  echo "$NAME already running in $STAND_WHERE"
  exit 0
fi
PROMPT="$REPO_MANAGER_SKILL project=$PROJECT${REPO:+ repo=$REPO}"
set +e; launch_agent "$STAND_PANE" "$CWD" "$NAME" "$MODEL" "$PROMPT"; rc=$?; set -e
[[ $rc -eq 0 ]] || die "$NAME did not start cleanly (rc=$rc); see $STAND_WHERE"
herdr agent rename "$STAND_PANE" "$AGENT" >/dev/null 2>&1 || true
echo "$NAME running in $STAND_WHERE"
if (( HOME_EXISTED )) && [[ -n "$PLACE_TAB" ]]; then
  echo "note: \"$HOME_WS\" already existed, so $NAME is a later tab, not tab 1"
fi
