#!/usr/bin/env bash
# project-env — print the resolved configuration of the current project, for skills and humans
# (instead of sourcing the env file by hand).
#
# Usage: project-env [--project P]          every key as KEY=value lines
#        project-env [--project P] KEY      just KEY's value (empty line + exit 1 when unknown)
#        project-env [--project P] --board  the board's ids, looked up live on GitHub (as GH_USER):
#                                            BOARD_NUMBER, BOARD_TITLE, BOARD_ID, STATUS_FIELD_ID and
#                                            STATUS_OPTION[<column>]=<option id>. Every repo of the
#                                            project shares one board, so repo profiles cite this
#                                            command instead of copying ids that can go stale.
# Maps print one line per entry: REPO_ROOT[<repo>]=<path>, WORKTREE_PARENT[<repo>]=<dir>, ROUTE_SKILL[<route>]=<skill>,
# REPO_MANAGER[<repo>]=<manager>, FIXTURE_EXT_BY_REPO[<repo>]=<ext>,
# AGENT_QC_NOTES_BY_REPO[<repo>]=<file>, SPEC_REPO[<repo>]=<spec repo>, SPEC_SCOPE[<repo>]=<text>.
# GH_REVIEW_GUARD prints its entries space-separated.
# `project-env REPO_ROOT` prints "<repo>=<path>" lines; `project-env 'REPO_ROOT[x]'` one value.
# Project: --project, else $PDO_PROJECT, else the project whose REPO_ROOT holds the cwd's repo.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=lib.sh
source "$HERE/bin/lib.sh"
PDO_SCRIPT=project-env
PROJECT="" KEY=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --project) PROJECT="$2"; shift 2 ;;
    --board) KEY="--board"; shift ;;
    -h|--help) sed -n '2,15p' "$0"; exit 0 ;;
    -*) pdo_die "unknown option: $1" ;;
    *) KEY="$1"; shift ;;
  esac
done
pdo_resolve_project "$PROJECT"
# shellcheck source=/dev/null
HERE="$PDO_ENV_DIR" source "$PDO_ENV_FILE"; pdo_finalize

SCALARS=(PROJECT ORG PROJECT_NUMBER PRIMARY_REPO DEFAULT_MODEL GH_USER AGENT_CLI BRIEF_TEMPLATE CONTROL_DIR
  IDENTITY_HOOK TEAM_UP_HOOK SYSREPORT_HOOK QC_HOOK QC_REPO BRANCH_PREFIX QC_WORKTREE QC_PORTS QC_PORTS_SHARED WATCH_EVENT_HOOK WATCH_EVENT_HOOK_TIMEOUT FIXTURE_EXT FIXTURE_BRANCH
  SYSTEM_MANAGER_WORKSPACE ORCHESTRATE_SKILL QC_SKILL INTAKE_SKILL PDO_SKILL_PREFIX CWT_STATUS QUEUE_LABEL P_LABELS
  LABEL_QC_READY LABEL_QC_DONE LABEL_MERGE_READY LABEL_UX_SKIPPED LABEL_NEEDS_UX LABEL_QC_ESCALATED CARRY_LABELS SCREENSHOT_DIR
  AGENT_QC_PORTS AGENT_QC_REPOS AGENT_QC_WORKTREE AGENT_QC_MAX_ROUNDS AGENT_QC_NOTES AGENT_QC_REVIEW_HOOK AGENT_QC_SKILL MAX_ACTIVE WEEKLY_CEILING FIVE_HOUR_CEILING
  MANAGER MANAGER_SLUG CLAIM_ASSIGNS PORTFOLIO_PRIORITY RESOURCE_PROFILE AGENT_MB AGENT_USAGE_WEIGHT FLEET_ADVICE
  PDO_ENV_FILE PDO_ENV_DIR PDO_STATE_DIR PDO_INBOX PDO_HOME)
map_lines() {  # map_lines <name> <prefix-style>: style "full" = NAME[k]=v, "short" = k=v
  declare -p "$1" >/dev/null 2>&1 || return 0
  local -n m="$1"; local k
  for k in $(printf '%s\n' "${!m[@]}" | sort); do
    if [[ "$2" == full ]]; then printf '%s[%s]=%s\n' "$1" "$k" "${m[$k]}"; else printf '%s=%s\n' "$k" "${m[$k]}"; fi
  done
}
managed() { declare -p SELF_MANAGED_REPOS >/dev/null 2>&1 && echo "${SELF_MANAGED_REPOS[*]}" || echo ""; }
guard() { declare -p GH_REVIEW_GUARD >/dev/null 2>&1 && echo "${GH_REVIEW_GUARD[*]}" || echo ""; }

if [[ "$KEY" == --board ]]; then
  [[ -n "${PROJECT_NUMBER:-}" ]] || pdo_die "project '$PROJECT' has no PROJECT_NUMBER (no board)"
  if [[ -n "${GH_USER:-}" ]]; then
    GH_TOKEN="$(gh auth token -u "$GH_USER" 2>/dev/null)" || pdo_die "no gh login for $GH_USER"
    export GH_TOKEN
  fi
  Q='query board($o:String!,$p:Int!){organization(login:$o){projectV2(number:$p){id number title
    field(name:"Status"){... on ProjectV2SingleSelectField{id options{id name}}}}}}'
  J="$(gh api graphql -f query="$Q" -F o="$ORG" -F p="$PROJECT_NUMBER")" \
    || pdo_die "board lookup failed (the token needs the read:project scope: gh auth refresh -s read:project)"
  jq -e '.data.organization.projectV2 != null' <<<"$J" >/dev/null 2>&1 \
    || pdo_die "no org Project #$PROJECT_NUMBER under $ORG (the board must be org-owned)"
  jq -r '.data.organization.projectV2 | "BOARD_NUMBER=\(.number)", "BOARD_TITLE=\(.title)", "BOARD_ID=\(.id)",
    "STATUS_FIELD_ID=\(.field.id // "")", (.field.options // [] | .[] | "STATUS_OPTION[\(.name)]=\(.id)")' <<<"$J"
  exit 0
fi
if [[ -z "$KEY" ]]; then
  for k in "${SCALARS[@]}"; do printf '%s=%s\n' "$k" "${!k:-}"; done
  printf 'SELF_MANAGED_REPOS=%s\n' "$(managed)"
  printf 'GH_REVIEW_GUARD=%s\n' "$(guard)"
  map_lines REPO_ROOT full; map_lines WORKTREE_PARENT full; map_lines ROUTE_SKILL full; map_lines REPO_MANAGER full; map_lines FIXTURE_EXT_BY_REPO full
  map_lines AGENT_QC_NOTES_BY_REPO full; map_lines SPEC_REPO full; map_lines SPEC_SCOPE full
  exit 0
fi
case "$KEY" in
  REPO_ROOT|WORKTREE_PARENT|ROUTE_SKILL|REPO_MANAGER|FIXTURE_EXT_BY_REPO|AGENT_QC_NOTES_BY_REPO|SPEC_REPO|SPEC_SCOPE) map_lines "$KEY" short ;;
  REPO_ROOT\[*\]|WORKTREE_PARENT\[*\]|ROUTE_SKILL\[*\]|REPO_MANAGER\[*\]|FIXTURE_EXT_BY_REPO\[*\]|AGENT_QC_NOTES_BY_REPO\[*\]|SPEC_REPO\[*\]|SPEC_SCOPE\[*\])
    n="${KEY%%[*}" k="${KEY#*[}"; k="${k%]}"
    declare -p "$n" >/dev/null 2>&1 || { echo; exit 1; }
    declare -n mm="$n"; [[ -n "${mm[$k]+x}" ]] || { echo; exit 1; }; echo "${mm[$k]}" ;;
  SELF_MANAGED_REPOS) managed ;;
  GH_REVIEW_GUARD) guard ;;
  *)
    [[ "$KEY" =~ ^[A-Z_][A-Z0-9_]*$ ]] || pdo_die "bad key: $KEY"
    if [[ -n "${!KEY+x}" ]]; then echo "${!KEY}"; else echo; exit 1; fi ;;
esac
