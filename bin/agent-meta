#!/usr/bin/env python3
"""agent-meta — record metadata for command agents that bin/spawn didn't start (or started
before metadata existed): adopted sessions, pre-existing workspaces.

Usage: agent-meta backfill [--project P]
For every herdr agent labelled "<Repo>-<n> <brief>" (a tab in its manager's home, or an old-layout
workspace), fills in (never overwrites) name, workspace/tab/pane, Claude session id, cwd, branch and
worktree.
"""
import json
import os
import re
import subprocess
import sys

sys.dont_write_bytecode = True  # keep the engine checkout free of __pycache__
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import pdo_config  # noqa: E402
import pdo_herdr  # noqa: E402

HERE = pdo_config.ENGINE_HOME


def git(cwd, *a):
    r = subprocess.run(["git", "-C", cwd, *a], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def main():
    if sys.argv[1:2] in (["-h"], ["--help"]):
        print(__doc__)
        return
    if sys.argv[1:2] != ["backfill"]:
        sys.exit(__doc__)
    project = sys.argv[sys.argv.index("--project") + 1] if "--project" in sys.argv else None
    cfg = pdo_config.load(project, "agent-meta")
    org, roots = cfg["org"], cfg["repo_root"]
    AGENTS = os.path.join(cfg["state_dir"], "agents")
    os.makedirs(AGENTS, exist_ok=True)
    for w in pdo_herdr.slots():
        m = re.match(r"^(\S+)-(\d+) (.+)$", w["name"] or "")
        if not m or m.group(1) not in roots:
            continue
        repo, num = m.group(1), int(m.group(2))
        a = w["agent"] if (w.get("agent") or {}).get("agent") == "claude" else {}
        cwd = a.get("cwd") or ""
        branch = git(cwd, "branch", "--show-current") if cwd else ""
        worktree = cwd
        if not branch or branch in ("main", "master"):  # adopted session in the repo root
            q = ('query($o:String!,$r:String!,$n:Int!){repository(owner:$o,name:$r){issue(number:$n){'
                 'closedByPullRequestsReferences(first:5,includeClosedPrs:true){nodes{number headRefName}}}}}')
            r = subprocess.run(["gh", "api", "graphql", "-f", f"query={q}", "-F", f"o={org}", "-F", f"r={repo}",
                                "-F", f"n={num}"], capture_output=True, text=True)
            try:
                nodes = json.loads(r.stdout)["data"]["repository"]["issue"]["closedByPullRequestsReferences"]["nodes"]
                branch = sorted(nodes, key=lambda n: -n["number"])[0]["headRefName"] if nodes else ""
            except Exception:
                branch = ""
            wl = git(roots[repo], "worktree", "list", "--porcelain")
            for blk in wl.split("\n\n"):
                if f"branch refs/heads/{branch}" in blk:
                    worktree = blk.split("\n")[0].removeprefix("worktree ")
        f = os.path.join(AGENTS, f"{repo}-{num}.json")
        meta = json.load(open(f, encoding="utf-8")) if os.path.exists(f) else {}
        found = {"repo": repo, "number": num, "name": w["name"], "workspace_id": w["workspace_id"], "tab_id": w.get("tab_id"),
                 "pane_id": a.get("pane_id"), "session_id": (a.get("agent_session") or {}).get("value"),
                 "cwd": cwd, "branch": branch, "worktree": worktree}
        for k, v in found.items():
            if v and not meta.get(k):
                meta[k] = v
        with open(f + ".tmp", "w", encoding="utf-8") as fh:
            json.dump(meta, fh, indent=1)
        os.replace(f + ".tmp", f)
        print(f"{repo}#{num}: session={meta.get('session_id')} branch={meta.get('branch')} cwd={meta.get('cwd')}")


if __name__ == "__main__":
    main()
