#!/usr/bin/env bash
# recycle-agent-qc — clear the QC Agent's context between PRs: wait until its turn ends, then send
# `/clear` (agent QC step 7, after a verdict). The /loop's scheduled wakeup survives /clear and
# re-sends the loop command into the fresh session, so nothing else is sent (tested 2026-10-22).
#
# Usage: recycle-agent-qc [--project P] [--foreground]
# By default it detaches (setsid) and returns at once, since the caller is the QC Agent's own turn.
# It skips the /clear (and logs why) when a PR is still in progress (the marker), the pane shows a
# question, or the turn hasn't ended within 30 min. AGENT_QC_RECYCLE=0 turns it off.
# Log: $PDO_STATE_DIR/agent-qc/recycle.log
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
die() { echo "recycle-agent-qc: $*" >&2; exit 1; }
# shellcheck source=lib.sh
source "$HERE/bin/lib.sh"

PROJECT="" FG=0
ARGS=("$@")
while [[ $# -gt 0 ]]; do
  case "$1" in
    --project) PROJECT="$2"; shift 2 ;;
    --foreground) FG=1; shift ;;
    -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
done
pdo_resolve_project "$PROJECT"
# shellcheck source=/dev/null
HERE="$PDO_ENV_DIR" source "$PDO_ENV_FILE"; pdo_finalize
[[ "${AGENT_QC_RECYCLE:-1}" != 0 ]] || { echo "recycle is off (AGENT_QC_RECYCLE=0)"; exit 0; }
STATE="$PDO_STATE_DIR/agent-qc"; mkdir -p "$STATE"
LOG="$STATE/recycle.log"
if [[ $FG -eq 0 ]]; then
  setsid -f "$0" "${ARGS[@]}" --foreground </dev/null >>"$LOG" 2>&1
  echo "recycle-agent-qc: will /clear the QC Agent once this turn ends (log: $LOG)"
  exit 0
fi

log() { echo "$(date '+%F %T') $*"; }
NAME="QC Agent ($PROJECT)"
WS_ID="$(herdr workspace list | jq -r --arg n "$NAME" '[.result.workspaces[] | select(.label == $n) | .workspace_id][0] // empty')"
[[ -n "$WS_ID" ]] || { log "skip: no workspace \"$NAME\""; exit 0; }
PANE="$(herdr agent list | jq -r --arg w "$WS_ID" '[.result.agents[] | select(.workspace_id == $w and .agent == "claude") | .pane_id][0] // empty')"
[[ -n "$PANE" ]] || { log "skip: no agent in \"$NAME\""; exit 0; }

sleep "${RECYCLE_SETTLE_SEC:-5}"  # the caller's turn is still running; let herdr see it as working
herdr agent wait "$PANE" --until idle --until done --until blocked --timeout 1800000 >/dev/null 2>&1 \
  || { log "skip: the turn didn't end within 30 min"; exit 0; }
sleep "${RECYCLE_SETTLE_SEC:-3}"
status="$(herdr agent list | jq -r --arg p "$PANE" '.result.agents[] | select(.pane_id == $p) | .agent_status' | head -1)"
case "$status" in idle|done) ;; *) log "skip: agent is $status"; exit 0 ;; esac
[[ ! -f "$STATE/in-progress.json" ]] || { log "skip: a PR is still in progress ($(jq -c '{repo,pr}' "$STATE/in-progress.json" 2>/dev/null))"; exit 0; }
if herdr pane read "$PANE" | tail -40 | grep -qE "Enter to select|Do you want to proceed"; then
  log "skip: a question is on screen"; exit 0
fi
herdr agent prompt "$PANE" "/clear" >/dev/null
log "cleared the QC Agent's context (pane $PANE)"
