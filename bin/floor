#!/usr/bin/env bash
# floor — show, set or clear the spawn floor (lowest P-level the orchestrator may start).
#
# Usage: floor                 show the active floor ("none" when unset)
#        floor P1|P2|P3|P4     only items at this P-level or higher auto-spawn (CWT included)
#        floor clear           remove the floor
#        [--project P]         default: $PDO_PROJECT, else detected from the cwd
#
# Persisted in $PDO_STATE_DIR/<project>-floor, so fresh orchestrator sessions and the watcher's
# queue view keep honouring it until cleared. The urgent bypass (P1-urgent AND Claude Work This)
# is unaffected; a floor of P2 or lower always allows P1.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=lib.sh
source "$HERE/bin/lib.sh"
PDO_SCRIPT=floor
PROJECT="" VALUE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --project) PROJECT="$2"; shift 2 ;;
    -h|--help) sed -n '2,11p' "$0"; exit 0 ;;
    *) VALUE="$1"; shift ;;
  esac
done
pdo_resolve_project "$PROJECT"
# shellcheck source=/dev/null
HERE="$PDO_ENV_DIR" source "$PDO_ENV_FILE"; pdo_finalize
F="$PDO_STATE_DIR/$PROJECT-floor"
mkdir -p "$(dirname "$F")"
case "${VALUE^^}" in
  "") [[ -s "$F" ]] && cat "$F" || echo none ;;
  P1|P2|P3|P4) echo "${VALUE^^}" >"$F"; echo "spawn floor set to ${VALUE^^}" ;;
  CLEAR|NONE|OFF) rm -f "$F"; echo "spawn floor cleared" ;;
  *) echo "floor: expected P1..P4 or clear, got '$VALUE'" >&2; exit 1 ;;
esac
