#!/usr/bin/env bash
# install — install project-dev-orchestration for one or more tools.
#
# Usage: install [--claude] [--codex] [--grok] [--bin] [--link] [--prefix DIR] [--dry-run]
#   --claude   Claude Code: add this repo as a plugin marketplace and install the plugin
#              (`claude plugin marketplace add` + `claude plugin install`).
#   --codex    Codex: add this repo as a plugin marketplace and install the plugin
#              (`codex plugin marketplace add` + `codex plugin add`).
#   --grok     Grok Build: install this repo as a plugin (`grok plugin install --trust`).
#   --bin      put the engine on PATH as `pdo` in --prefix (default ~/.local/bin), and check the
#              engine's requirements. Run any engine script as `pdo <script> ...`.
#              From a git checkout: a symlink to bin/pdo. From an installed plugin (a versioned
#              plugin-cache dir such as .../project-dev-orchestration/0.9.8): a small launcher that
#              runs the newest installed version, so plugin updates need no re-install. This is how
#              /project-setup installs the engine for a team.
#   --link     instead of the tool's plugin system, symlink each skill into the tool's user skill
#              dir: ~/.claude/skills (Claude Code), ~/.agents/skills (Codex), $GROK_HOME/skills or
#              ~/.grok/skills (Grok). Also the fallback when the tool's CLI isn't installed.
#              Linked skills are un-namespaced: set PDO_SKILL_PREFIX="/" in your config.env so the
#              engine launches /project-orchestrate rather than /pdo:project-orchestrate.
#   --dry-run  print what would be done.
# Links only: an existing non-link file or dir with the same name is left alone and reported.
#
# Usage: install --gh-identities [--map FILE] [--dry-run] [--uninstall] [--check]
#   Several GitHub accounts on one machine, without `gh auth switch` (README "Multiple GitHub
#   accounts"). The map is ${XDG_CONFIG_HOME:-~/.config}/project-dev-orchestration/gh-identities,
#   one line per owner `<owner> <gh-login> [<commit-email>] [<commit-name>]` plus `default <login>`.
#   Installs the gh shim (${XDG_DATA_HOME:-~/.local/share}/project-dev-orchestration/shims/gh) and
#   the git credential helper, writes gitconfig-identities (+ gitconfig-identities.d/<owner>) next
#   to the map, appends one [include] line to your global gitconfig, and prints the PATH line for
#   your shell profile (it never edits shell profiles).
#   --map FILE   install FILE as the map first (the old one is kept as gh-identities.bak).
#   --uninstall  remove the shim, the helper, the generated git files and the include line (the
#                map stays).
#   --check      report the effective identity for the current dir and whether the shim is first
#                on PATH (exit 1 when something is off).
#   It also writes the review guard (gh-review-guard next to the map) from every project's
#   GH_REVIEW_GUARD: in an agent session the shim refuses PR review writes as the project's GH_USER
#   on those repos. Re-run after changing GH_REVIEW_GUARD, or `install --review-guard` for just that.
set -euo pipefail
REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
NAME=project-dev-orchestration   # the marketplace
PLUGIN=pdo                       # the plugin; Claude Code shows its skills as /pdo:<skill>
DO_CLAUDE=0 DO_CODEX=0 DO_GROK=0 DO_BIN=0 LINK=0 DRY=0 PREFIX="$HOME/.local/bin"
DO_GHID=0 GHID_MODE=install GHID_MAP_SRC=""
usage() { sed -n '2,35p' "$0"; }
[[ $# -gt 0 ]] || { usage; exit 2; }
while [[ $# -gt 0 ]]; do
  case "$1" in
    --claude) DO_CLAUDE=1; shift ;;
    --codex) DO_CODEX=1; shift ;;
    --grok) DO_GROK=1; shift ;;
    --bin) DO_BIN=1; shift ;;
    --link) LINK=1; shift ;;
    --prefix) PREFIX="$2"; shift 2 ;;
    --dry-run) DRY=1; shift ;;
    --gh-identities) DO_GHID=1; shift ;;
    --review-guard) DO_GHID=1; GHID_MODE=guard; shift ;;
    --map) GHID_MAP_SRC="$2"; shift 2 ;;
    --uninstall) GHID_MODE=uninstall; shift ;;
    --check) GHID_MODE=check; shift ;;
    --status) GHID_MODE=status; shift ;;  # one line, for fleet / sysreport
    -h|--help) usage; exit 0 ;;
    *) echo "install: unknown option $1" >&2; exit 2 ;;
  esac
done

run() { if [[ $DRY -eq 1 ]]; then echo "would run: $*"; else echo "+ $*"; "$@"; fi; }

link() {  # link <src> <dst>
  local src="$1" dst="$2"
  if [[ -e "$dst" && ! -L "$dst" ]]; then echo "skip: $dst exists and is not a link"; return 0; fi
  if [[ $DRY -eq 1 ]]; then echo "would link: $dst -> $src"; return 0; fi
  mkdir -p "$(dirname "$dst")"
  ln -sfn "$src" "$dst"
  echo "linked: $dst -> $src"
}

link_skills() {  # link_skills <dest dir>
  local n=0 d
  for d in "$REPO"/skills/*/; do
    [[ -f "$d/SKILL.md" ]] || continue
    link "${d%/}" "$1/$(basename "$d")"; n=$((n + 1))
  done
  [[ $n -gt 0 ]] || echo "install: no skills found under $REPO/skills" >&2
  echo "note: linked skills are un-namespaced; set PDO_SKILL_PREFIX=\"/\" in your config.env"
}

if [[ $DO_CLAUDE -eq 1 ]]; then
  if [[ $LINK -eq 0 ]] && command -v claude >/dev/null; then
    run claude plugin marketplace add "$REPO"
    run claude plugin install "$PLUGIN@$NAME"
  else
    [[ $LINK -eq 1 ]] || echo "install: claude CLI not found; linking skills instead"
    link_skills "$HOME/.claude/skills"
  fi
fi
if [[ $DO_CODEX -eq 1 ]]; then
  if [[ $LINK -eq 0 ]] && command -v codex >/dev/null; then
    run codex plugin marketplace add "$REPO"
    run codex plugin add "$PLUGIN@$NAME"
  else
    [[ $LINK -eq 1 ]] || echo "install: codex CLI not found; linking skills instead"
    link_skills "$HOME/.agents/skills"
  fi
fi
if [[ $DO_GROK -eq 1 ]]; then
  if [[ $LINK -eq 0 ]] && command -v grok >/dev/null; then
    run grok plugin install "$REPO" --trust
  else
    [[ $LINK -eq 1 ]] || echo "install: grok CLI not found; linking skills instead"
    link_skills "${GROK_HOME:-$HOME/.grok}/skills"
  fi
fi
LAUNCHER_MARK="# pdo launcher (project-dev-orchestration bin/install --bin)"

# A plugin install lives in a versioned dir (<plugin dir>/<version>/) that the tool replaces on update,
# and has no .git; a checkout is stable, so it gets the plain symlink.
from_plugin() {
  [[ ! -e "$REPO/.git" && "$(basename "$REPO")" =~ ^[0-9]+(\.[0-9]+)+([-+][0-9A-Za-z.-]+)?$ ]]
}

is_launcher() { [[ -f "$1" && ! -L "$1" ]] && grep -qxF "$LAUNCHER_MARK" "$1" 2>/dev/null; }

write_launcher() {  # write_launcher <dst>: a pdo that runs the newest version under the plugin dir
  local dst="$1" versions; versions="$(dirname "$REPO")"
  if [[ -e "$dst" && ! -L "$dst" ]] && ! is_launcher "$dst"; then
    echo "skip: $dst exists and is not a pdo link or launcher"; return 0
  fi
  if [[ $DRY -eq 1 ]]; then echo "would write launcher: $dst -> newest $versions/*/bin/pdo"; return 0; fi
  mkdir -p "$(dirname "$dst")"
  rm -f "$dst"
  cat >"$dst" <<EOF
#!/usr/bin/env bash
$LAUNCHER_MARK
# Runs the newest installed plugin version, so plugin updates need no re-install.
# PDO_HOME=<engine checkout> overrides it (e.g. to try a local checkout).
set -euo pipefail
VERSIONS=$(printf '%q' "$versions")
if [[ -n "\${PDO_HOME:-}" && -x "\$PDO_HOME/bin/pdo" ]]; then exec "\$PDO_HOME/bin/pdo" "\$@"; fi
latest="\$(ls -d "\$VERSIONS"/*/bin/pdo 2>/dev/null | sort -V | tail -n 1)"
[[ -n "\$latest" ]] || { echo "pdo: no engine under \$VERSIONS; reinstall the project-dev-orchestration plugin" >&2; exit 127; }
exec "\$latest" "\$@"
EOF
  chmod +x "$dst"
  echo "wrote launcher: $dst -> newest $versions/*/bin/pdo"
}

check_requirements() {  # report what the engine needs and this machine lacks; never fails the install
  local missing=() c
  for c in git jq gh python3 herdr; do command -v "$c" >/dev/null || missing+=("$c"); done
  (( BASH_VERSINFO[0] >= 4 )) || missing+=("bash-4+")
  if command -v python3 >/dev/null && ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 8))'; then
    missing+=("python-3.8+")
  fi
  if [[ ${#missing[@]} -eq 0 ]]; then echo "requirements: ok (bash, git, jq, gh, python3, herdr)"
  else echo "requirements: missing ${missing[*]}; the engine needs them before 'pdo team-up'"; fi
}

if [[ $DO_BIN -eq 1 ]]; then
  if from_plugin; then
    write_launcher "$PREFIX/pdo"
  elif is_launcher "$PREFIX/pdo"; then
    # a checkout replaces an earlier plugin launcher
    if [[ $DRY -eq 1 ]]; then echo "would replace launcher: $PREFIX/pdo -> $REPO/bin/pdo"
    else rm -f "$PREFIX/pdo"; link "$REPO/bin/pdo" "$PREFIX/pdo"; fi
  else
    link "$REPO/bin/pdo" "$PREFIX/pdo"
  fi
  case ":$PATH:" in *":$PREFIX:"*) ;; *) echo "note: $PREFIX is not on your PATH; add it to your shell profile" ;; esac
  check_requirements
fi

# ---------------------------------------------------------------------------------------------
# --gh-identities: one gh login per repo owner (bin/gh-identity-shim, bin/gh-identity-credential)
# ---------------------------------------------------------------------------------------------
GHID_CFG="${XDG_CONFIG_HOME:-$HOME/.config}/project-dev-orchestration"
GHID_MAP="${PDO_GH_IDENTITIES:-$GHID_CFG/gh-identities}"
GHID_DATA="${XDG_DATA_HOME:-$HOME/.local/share}/project-dev-orchestration"
GHID_SHIM_DIR="$GHID_DATA/shims"
GHID_HELPER="$GHID_DATA/gh-identity-credential"
GHID_GITINC="$GHID_CFG/gitconfig-identities"
GHID_OWNER_DIR="$GHID_CFG/gitconfig-identities.d"
GHID_GUARD="$GHID_CFG/gh-review-guard"
GHID_MARK="# project-dev-orchestration gh identities (pdo install --gh-identities --uninstall removes this)"

ghid_global_gitconfig() {  # the global gitconfig git reads last
  if [[ -n "${GIT_CONFIG_GLOBAL:-}" ]]; then echo "$GIT_CONFIG_GLOBAL"
  elif [[ -f "$HOME/.gitconfig" ]]; then echo "$HOME/.gitconfig"
  elif [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/git/config" ]]; then echo "${XDG_CONFIG_HOME:-$HOME/.config}/git/config"
  else echo "$HOME/.gitconfig"
  fi
}

# ghid_parse <map>: prints "owner<TAB>login<TAB>email<TAB>name" per owner, then "default<TAB>login"
ghid_parse() {
  local f="$1" ln=0 line owner login rest email name seen=" "
  [[ -r "$f" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    ln=$((ln + 1))
    line="${line%%[[:space:]]#*}"; [[ "$line" == \#* ]] && continue
    read -r owner login rest <<<"$line" || true
    [[ -z "$owner" ]] && continue
    if [[ -z "$login" || ! "$owner" =~ ^[A-Za-z0-9][A-Za-z0-9-]*$ || ! "$login" =~ ^[A-Za-z0-9][A-Za-z0-9-]*$ ]]; then
      echo "install: $f:$ln: expected '<owner> <gh-login> [<email>] [<name>]': $line" >&2; return 1
    fi
    case "$seen" in *" ${owner,,} "*) echo "install: $f:$ln: owner '$owner' listed twice" >&2; return 1 ;; esac
    seen+="${owner,,} "
    email="" name="$rest"
    if [[ "$rest" =~ ^([^[:space:]]+@[^[:space:]]+)[[:space:]]*(.*)$ ]]; then email="${BASH_REMATCH[1]}" name="${BASH_REMATCH[2]}"; fi
    printf '%s\t%s\t%s\t%s\n' "$owner" "$login" "$email" "$name"
  done <"$f"
}

ghid_quote() { local v="${1//\\/\\\\}"; printf '"%s"' "${v//\"/\\\"}"; }  # a git config value

ghid_render() {  # ghid_render <parsed>: writes the generated git files under a temp dir ($1)
  local out="$1" parsed="$2" owner login email name def="" f
  mkdir -p "$out/d"
  {
    echo "# Generated by pdo install --gh-identities from $GHID_MAP. Do not edit: edit the map and re-run."
    echo "# Credential helpers are per URL (so a clone works before any remote exists); user.email/name"
    echo "# come from the per-owner file, included when any remote of the repo is under that owner."
    def="$(awk -F'\t' '$1 == "default" {print $2}' <<<"$parsed")"
    if [[ -n "$def" ]]; then
      printf '[credential "https://github.com"]\n\thelper =\n\thelper = %s\n' "$(ghid_quote "!'$GHID_HELPER' $def")"
    fi
    while IFS=$'\t' read -r owner login email name; do
      [[ -z "$owner" || "$owner" == default ]] && continue
      printf '[credential "https://github.com/%s"]\n\thelper =\n\thelper = %s\n\tuseHttpPath = true\n' \
        "$owner" "$(ghid_quote "!'$GHID_HELPER' $login")"
    done <<<"$parsed"
    while IFS=$'\t' read -r owner login email name; do
      [[ -z "$owner" || "$owner" == default ]] && continue
      [[ -n "$email$name" ]] || continue
      f="$GHID_OWNER_DIR/$owner.gitconfig"
      { echo "# Generated for owner $owner (login $login)."; echo "[user]"
        [[ -n "$email" ]] && printf '\temail = %s\n' "$(ghid_quote "$email")"
        [[ -n "$name" ]] && printf '\tname = %s\n' "$(ghid_quote "$name")"
      } >"$out/d/$owner.gitconfig"
      for pre in "https://github.com/" "https://*@github.com/" "git@github.com:" "ssh://git@github.com/"; do
        printf '[includeIf "hasconfig:remote.*.url:%s%s/**"]\n\tpath = %s\n' "$pre" "$owner" "$(ghid_quote "$f")"
      done
    done <<<"$parsed"
  } >"$out/gitconfig-identities"
}

ghid_include_line() { printf '\tpath = %s\n' "$(ghid_quote "$GHID_GITINC")"; }

ghid_remove_block() {  # ghid_remove_block <gitconfig>: drop our marker + [include] + path lines
  local g="$1" tmp
  [[ -f "$g" ]] || return 0
  tmp="$(mktemp "$g.XXXXXX")"
  awk -v mark="$GHID_MARK" -v pl="$(ghid_include_line)" '
    { line[NR] = $0 }
    END {
      for (i = 1; i <= NR; i++) {
        if (line[i] == mark && line[i + 1] == "[include]" && line[i + 2] == pl) {
          if (n > 0 && keep[n] == "") n--
          i += 2; continue
        }
        keep[++n] = line[i]
      }
      for (i = 1; i <= n; i++) print keep[i]
    }' "$g" >"$tmp"
  if cmp -s "$g" "$tmp"; then rm -f "$tmp"; else cat "$tmp" >"$g"; rm -f "$tmp"; fi  # keep the inode / symlink
}

ghid_has_block() { grep -Fxq "$GHID_MARK" "$1" 2>/dev/null && grep -Fxq "$(ghid_include_line)" "$1"; }

ghid_block_is_last() {  # no [credential ...] section after our include block
  awk -v mark="$GHID_MARK" '$0 == mark {m = NR} /^[[:space:]]*\[credential/ {c = NR} END {exit !(m && c < m)}' "$1"
}

ghid_append_block() { printf '\n%s\n[include]\n%s\n' "$GHID_MARK" "$(ghid_include_line)" >>"$1"; }

ghid_owners_summary() {  # "a->x, b->y; default z" from the map
  local parsed; parsed="$(ghid_parse "$GHID_MAP" 2>/dev/null)" || { echo "map unreadable"; return; }
  awk -F'\t' '$1 != "default" && $1 != "" {o = o (o ? ", " : "") $1 "->" $2} $1 == "default" {d = $2}
    END {printf "%s", (o ? o : "no owners"); if (d) printf "; default %s", d; print ""}' <<<"$parsed"
}

ghid_shim_state() {  # active | installed, not first on PATH | not installed
  local first; first="$(command -v gh 2>/dev/null || true)"
  if [[ ! -x "$GHID_SHIM_DIR/gh" ]]; then echo "not installed"
  elif [[ "$first" == "$GHID_SHIM_DIR/gh" ]]; then echo "active"
  else echo "installed, not first on PATH (gh is ${first:-missing})"
  fi
}

# ghid_guard_lines: the review guard rules, "<OWNER/REPO glob> <login> <scope>", from every project's
# GH_REVIEW_GUARD (the login is that project's GH_USER; an entry without a login is skipped).
ghid_guard_lines() {
  local p
  while read -r p _; do
    [[ -n "$p" ]] || continue
    "$REPO/bin/pdo-config" --json --project "$p" 2>/dev/null \
      | jq -r '.review_guard[]? | select(.login != "" and .repo != "") | "\(.repo) \(.login) \(.scope)"' || true
  done < <("$REPO/bin/pdo-config" --list 2>/dev/null) | sort -u
}

ghid_guard_install() {
  local lines; lines="$(ghid_guard_lines)"
  if [[ $DRY -eq 1 ]]; then echo "would write: $GHID_GUARD"; sed 's/^/    /' <<<"$lines"; return 0; fi
  mkdir -p "$GHID_CFG"
  { echo "# Generated by pdo install --gh-identities (or --review-guard) from each project's GH_REVIEW_GUARD."
    echo "# <OWNER/REPO glob> <login> <scope: all | verdicts>. Do not edit: edit the project env and re-run."
    [[ -n "$lines" ]] && printf '%s\n' "$lines"; } >"$GHID_GUARD.tmp" && mv "$GHID_GUARD.tmp" "$GHID_GUARD"
  echo "wrote: $GHID_GUARD ($(grep -vc '^#' "$GHID_GUARD" || true) rule(s))"
}

ghid_install() {
  local g parsed tmp
  if [[ -n "$GHID_MAP_SRC" ]]; then
    [[ -r "$GHID_MAP_SRC" ]] || { echo "install: --map $GHID_MAP_SRC: not readable" >&2; exit 1; }
    ghid_parse "$GHID_MAP_SRC" >/dev/null || exit 1
    if [[ "$(readlink -f "$GHID_MAP_SRC")" != "$(readlink -f "$GHID_MAP" 2>/dev/null)" ]] && ! cmp -s "$GHID_MAP_SRC" "$GHID_MAP"; then
      if [[ $DRY -eq 1 ]]; then echo "would install map: $GHID_MAP (from $GHID_MAP_SRC)"
      else
        mkdir -p "$(dirname "$GHID_MAP")"
        [[ -f "$GHID_MAP" ]] && cp -p "$GHID_MAP" "$GHID_MAP.bak" && echo "saved old map: $GHID_MAP.bak"
        cp "$GHID_MAP_SRC" "$GHID_MAP"; echo "installed map: $GHID_MAP"
      fi
    fi
  elif [[ ! -f "$GHID_MAP" ]]; then
    if [[ $DRY -eq 1 ]]; then echo "would write a template map: $GHID_MAP"
    else
      mkdir -p "$(dirname "$GHID_MAP")"
      cat >"$GHID_MAP" <<'EOF'
# gh identities: which gh login works each GitHub owner (org or user). One line per owner:
#   <owner> <gh-login> [<commit-email>] [<commit-name>]
# plus `default <login>` for every other owner. Each login must be added to gh once
# (PDO_GH_ALLOW_SWITCH=1 gh auth login). Re-run `pdo install --gh-identities` after editing.
#
# acme-corp  alice-work  alice@acme-corp.example  Alice Example
# alice      alice       alice@example.com
# default    alice
EOF
      echo "wrote a template map: $GHID_MAP (edit it, then re-run pdo install --gh-identities)"
    fi
  fi
  if [[ $DRY -eq 1 && -n "$GHID_MAP_SRC" ]]; then parsed="$(ghid_parse "$GHID_MAP_SRC")" || exit 1
  else parsed="$(ghid_parse "$GHID_MAP")" || exit 1
  fi

  # the shim and the helper: copies, so a moved or updated checkout never breaks git or gh
  if [[ $DRY -eq 1 ]]; then
    echo "would install: $GHID_SHIM_DIR/gh (from bin/gh-identity-shim)"
    echo "would install: $GHID_HELPER"
  else
    mkdir -p "$GHID_SHIM_DIR"
    install -m 0755 "$REPO/bin/gh-identity-shim" "$GHID_SHIM_DIR/gh"
    install -m 0755 "$REPO/bin/gh-identity-credential" "$GHID_HELPER"
    echo "installed: $GHID_SHIM_DIR/gh"
    echo "installed: $GHID_HELPER"
  fi

  # generated git files (the per-owner dir is fully managed: stale owners are removed)
  tmp="$(mktemp -d)"
  ghid_render "$tmp" "$parsed"
  if [[ $DRY -eq 1 ]]; then
    echo "would write: $GHID_GITINC"; sed 's/^/    /' "$tmp/gitconfig-identities"
    for f in "$tmp"/d/*.gitconfig; do [[ -f "$f" ]] && echo "would write: $GHID_OWNER_DIR/$(basename "$f")"; done
  else
    mkdir -p "$GHID_CFG"
    rm -rf "$GHID_OWNER_DIR"; mkdir -p "$GHID_OWNER_DIR"
    cp "$tmp"/d/*.gitconfig "$GHID_OWNER_DIR/" 2>/dev/null || true
    cp "$tmp/gitconfig-identities" "$GHID_GITINC"
    echo "wrote: $GHID_GITINC ($(grep -c '^\[credential' "$GHID_GITINC") credential, $(grep -c '^\[includeIf' "$GHID_GITINC") includeIf section(s))"
  fi
  rm -rf "$tmp"
  ghid_guard_install

  # the one line in the global gitconfig: last, so its helpers come after gh's own github.com ones
  g="$(ghid_global_gitconfig)"
  if ghid_has_block "$g" && ghid_block_is_last "$g"; then
    echo "git include: already in $g"
  elif [[ $DRY -eq 1 ]]; then
    echo "would add to the end of $g: [include] path = $GHID_GITINC"
  else
    if ghid_has_block "$g"; then ghid_remove_block "$g"; echo "git include: moved below the later [credential] sections"; fi
    mkdir -p "$(dirname "$g")"; ghid_append_block "$g"
    echo "git include: added to $g"
  fi
  if git config --global --get-all include.path 2>/dev/null | grep -Fxq "$GHID_GITINC" && ! ghid_has_block "$g"; then
    echo "note: $g also includes $GHID_GITINC outside the managed block"
  fi
  local gv; gv="$(git version | awk '{print $3}')"
  if [[ "$(printf '%s\n2.36\n' "$gv" | sort -V | head -1)" != 2.36 ]]; then
    echo "warning: git $gv is older than 2.36: includeIf hasconfig (per-owner user.email) is ignored" >&2
  fi
  echo
  echo "Add this line to your shell profile (e.g. ~/.bashrc or ~/.zshrc), then open a new shell:"
  echo "  export PATH=\"$GHID_SHIM_DIR:\$PATH\""
  echo "Check with: pdo install --gh-identities --check"
}

ghid_uninstall() {
  local g; g="$(ghid_global_gitconfig)"
  local f
  for f in "$GHID_SHIM_DIR/gh" "$GHID_HELPER"; do
    [[ -e "$f" ]] || continue
    if ! grep -q 'PDO_GH_IDENTITY_SHIM' "$f" 2>/dev/null; then echo "skip: $f is not ours"; continue; fi
    if [[ $DRY -eq 1 ]]; then echo "would remove: $f"; else rm -f "$f"; echo "removed: $f"; fi
  done
  for f in "$GHID_GITINC" "$GHID_OWNER_DIR" "$GHID_GUARD"; do
    [[ -e "$f" ]] || continue
    if [[ $DRY -eq 1 ]]; then echo "would remove: $f"; else rm -rf "$f"; echo "removed: $f"; fi
  done
  if ghid_has_block "$g"; then
    if [[ $DRY -eq 1 ]]; then echo "would remove the include line from $g"; else ghid_remove_block "$g"; echo "removed the include line from $g"; fi
  fi
  [[ -d "$GHID_SHIM_DIR" && $DRY -eq 0 ]] && rmdir "$GHID_SHIM_DIR" 2>/dev/null || true
  echo "kept the map: $GHID_MAP"
  echo "Remove this line from your shell profile: export PATH=\"$GHID_SHIM_DIR:\$PATH\""
}

ghid_check() {
  local bad=0 shim state explain owner login url user email name want
  state="$(ghid_shim_state)"
  echo "shim: $state ($GHID_SHIM_DIR/gh)"
  [[ "$state" == active ]] || bad=1
  if [[ -x "$GHID_SHIM_DIR/gh" ]] && ! cmp -s "$GHID_SHIM_DIR/gh" "$REPO/bin/gh-identity-shim"; then
    echo "STALE: the installed shim differs from bin/gh-identity-shim (re-run pdo install --gh-identities)"; bad=1
  fi
  local want_guard; want_guard="$(ghid_guard_lines)"
  if [[ -n "$want_guard" || -f "$GHID_GUARD" ]]; then
    echo "review guard: $GHID_GUARD: $( [[ -f "$GHID_GUARD" ]] && grep -v '^#' "$GHID_GUARD" | paste -sd ';' - || echo missing)"
    if [[ "$want_guard" != "$(grep -v '^#' "$GHID_GUARD" 2>/dev/null)" ]]; then
      echo "STALE: the review guard differs from the projects' GH_REVIEW_GUARD (pdo install --review-guard)"; bad=1
    fi
  fi
  echo "map: $GHID_MAP: $( [[ -r "$GHID_MAP" ]] && ghid_owners_summary || echo missing)"
  [[ -n "${GH_TOKEN:-}${GITHUB_TOKEN:-}" ]] && echo "note: GH_TOKEN/GITHUB_TOKEN is set in this shell, so gh runs as that token here (the shim passes it through)"
  shim="$GHID_SHIM_DIR/gh"; [[ -x "$shim" ]] || shim="$REPO/bin/gh-identity-shim"
  explain="$(env -u GH_TOKEN -u GITHUB_TOKEN PDO_GH_EXPLAIN=1 "$shim" status 2>&1 >/dev/null)"
  owner="$(sed -n 's/.*owner=\([^ ]*\).*/\1/p' <<<"$explain")"
  login="$(sed -n 's/.*login=\(.*\) via=.*/\1/p' <<<"$explain")"
  echo "this dir: owner ${owner} ($(sed -n 's/.*rule=\([^ ]*\).*/\1/p' <<<"$explain")) -> login $login ($(sed -n 's/.*via=\([^ ]*\).*/\1/p' <<<"$explain"))"
  email="$(git config user.email 2>/dev/null || true)"; name="$(git config user.name 2>/dev/null || true)"
  echo "this dir: commits as ${name:-(no user.name)} <${email:-no user.email}>"
  if [[ -n "$owner" && "$owner" != - ]]; then
    user="$(printf 'protocol=https\nhost=github.com\npath=%s/probe.git\n\n' "$owner" \
      | env -u GH_TOKEN -u GITHUB_TOKEN GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=true SSH_ASKPASS=true git credential fill 2>/dev/null \
      | sed -n 's/^username=//p')"
    echo "git over https://github.com/$owner/: username ${user:-(none)}"
    want="${login%% *}"
    if grep -q 'via=map\|via=default' <<<"$explain" && [[ "$user" != "$want" ]]; then
      echo "MISMATCH: git answers as '${user:-nothing}', the map says '$want' (is the include line last in $(ghid_global_gitconfig)?)"
      bad=1
    fi
  fi
  return $bad
}

ghid_status() {  # one line for fleet / sysreport
  if [[ ! -x "$GHID_SHIM_DIR/gh" && ! -f "$GHID_MAP" ]]; then echo "not set up (pdo install --gh-identities)"; return 0; fi
  echo "shim $(ghid_shim_state); map: $( [[ -r "$GHID_MAP" ]] && ghid_owners_summary || echo missing)$( [[ -f "$GHID_GUARD" ]] && echo "; review guard: $(grep -vc '^#' "$GHID_GUARD") rule(s)")"
}

if [[ $DO_GHID -eq 1 ]]; then
  case "$GHID_MODE" in
    install) ghid_install ;;
    guard) ghid_guard_install ;;
    uninstall) ghid_uninstall ;;
    check) ghid_check ;;
    status) ghid_status ;;
  esac
fi
